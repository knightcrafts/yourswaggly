{%- liquid
  assign s = section.settings
  assign heading_tag = s.heading_tag | default: 'h1'
-%}

<section class="waggly-prose top-spacing-{{ s.top_spacing }}{% if s.heading_style == 'handwritten' %} waggly-prose--hand{% endif %} waggly-prose--body-{{ s.body_align }}">
  <div class="{% if s.width == 'page-wide' %}page-wide{% else %}page-width{% endif %}">
    <div class="waggly-prose__box" style="--wg-prose-bg: {{ s.bg_color }}; --wg-prose-text: {{ s.text_color }}; --wg-prose-accent: {{ s.accent_color }}; --wg-prose-radius: {{ s.radius | default: 32 }}px; --wg-prose-pad: {{ s.vertical_padding | default: 64 }}px; --wg-prose-maxw: {{ s.max_width | default: 720 }}px;">

      {%- if section.blocks.size > 0 -%}
        <div class="waggly-prose__deco" aria-hidden="true">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            {%- assign src = '' -%}
            {%- if b.image != blank -%}
              {%- assign src = b.image | image_url: width: 900 -%}
            {%- elsif b.asset != blank -%}
              {%- assign src = b.asset | asset_url -%}
            {%- endif -%}
            {%- if src != blank -%}
              <div class="waggly-prose__deco-item{% unless b.show_desktop %} waggly-prose__deco-item--hide-desktop{% endunless %}{% unless b.show_mobile %} waggly-prose__deco-item--hide-mobile{% endunless %}"
                style="--x: {{ b.x }}; --y: {{ b.y }}; --w: {{ b.width }}px; --mscale: {{ b.mobile_scale | divided_by: 100.0 }}; --rot: {{ b.rotation }}deg; --op: {{ b.opacity | divided_by: 100.0 }}; --flip: {% if b.flip_x %}-1{% else %}1{% endif %};"
                {{ block.shopify_attributes }}>
                {% # theme-check-disable ImgWidthAndHeight %}
                <img src="{{ src }}" alt="" loading="lazy"{% if b.image != blank %} width="{{ b.image.width }}" height="{{ b.image.height }}"{% endif %}>
                {% # theme-check-enable ImgWidthAndHeight %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="waggly-prose__content">
        {%- if s.eyebrow != blank -%}<p class="waggly-prose__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<{{ heading_tag }} class="waggly-prose__heading">{{ s.heading | escape }}</{{ heading_tag }}>{%- endif -%}
        {%- if s.body != blank -%}<div class="waggly-prose__body rte">{{ s.body }}</div>{%- endif -%}
        {%- if s.signature != blank or s.signature_sub != blank -%}
          <div class="waggly-prose__sign">
            {%- if s.signature != blank -%}<p class="waggly-prose__sign-name">{{ s.signature | escape }}</p>{%- endif -%}
            {%- if s.signature_sub != blank -%}<p class="waggly-prose__sign-sub">{{ s.signature_sub | escape }}</p>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.waggly-prose__box {
  position: relative;
  overflow: hidden;
  background: var(--wg-prose-bg, #ffffff);
  color: var(--wg-prose-text, #0D386F);
  border-radius: var(--wg-prose-radius, 32px);
  padding: var(--wg-prose-pad, 64px) clamp(20px, 5vw, 64px);
}
.waggly-prose__deco { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
.waggly-prose__deco-item {
  position: absolute;
  left: calc(var(--x) * 1%);
  top: calc(var(--y) * 1%);
  width: var(--w, 160px);
  transform: translate(-50%, -50%) rotate(var(--rot, 0deg)) scaleX(var(--flip, 1));
  opacity: var(--op, .2);
}
.waggly-prose__deco-item img { display: block; width: 100%; height: auto; }

.waggly-prose__content { position: relative; z-index: 1; max-width: var(--wg-prose-maxw, 720px); margin: 0 auto; }
.waggly-prose__eyebrow {
  font-family: var(--font-body-family);
  font-weight: 600;
  font-size: .9rem;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--wg-prose-accent, var(--color-accent));
  text-align: center;
  margin: 0 0 14px;
}
.waggly-prose__heading {
  font-family: var(--font-heading-family);
  font-weight: 700;
  color: var(--wg-prose-text, var(--color-base));
  font-size: clamp(2rem, 4.4vw, 3.1rem);
  line-height: 1.15;
  text-align: center;
  margin: 0 0 32px;
}
.waggly-prose--hand .waggly-prose__heading { font-family: 'Kalam', cursive; }
.waggly-prose__body { color: var(--wg-prose-text, var(--color-base)); font-size: 1.08rem; line-height: 1.75; }
.waggly-prose--body-center .waggly-prose__body { text-align: center; }
.waggly-prose__body p { margin: 0 0 1.25em; }
.waggly-prose__body p:last-child { margin-bottom: 0; }
.waggly-prose__body em { font-style: italic; }

.waggly-prose__sign { text-align: center; margin-top: 40px; }
.waggly-prose__sign-name { font-family: 'Kalam', cursive; font-size: 1.9rem; color: var(--wg-prose-accent, var(--color-accent)); margin: 0; }
.waggly-prose__sign-sub {
  font-family: var(--font-body-family);
  font-size: .85rem;
  letter-spacing: .14em;
  text-transform: uppercase;
  opacity: .7;
  margin: 6px 0 0;
}

@media (max-width: 749px) {
  .waggly-prose__box { padding: 40px 22px; }
  .waggly-prose__deco-item { width: calc(var(--w, 160px) * var(--mscale, 1)); }
  .waggly-prose__deco-item--hide-mobile { display: none; }
}
@media (min-width: 750px) {
  .waggly-prose__deco-item--hide-desktop { display: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly prose",
  "tag": "section",
  "class": "waggly-prose-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Love Beyond the Bowl" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading style",
      "options": [
        { "value": "normal", "label": "Normal (Outfit)" },
        { "value": "handwritten", "label": "Handwritten (Kalam)" }
      ],
      "default": "normal"
    },
    { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>Tell your story here.</p>" },
    {
      "type": "select",
      "id": "body_align",
      "label": "Body alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "signature", "label": "Signature (optional)", "default": "Yours Waggly" },
    { "type": "text", "id": "signature_sub", "label": "Signature subline (optional)", "default": "Love Beyond the Bowl" },
    { "type": "header", "content": "Box style" },
    { "type": "color", "id": "bg_color", "label": "Box background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#0D386F" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#E83D74" },
    { "type": "range", "id": "max_width", "label": "Reading column width", "min": 520, "max": 960, "step": 20, "unit": "px", "default": 720 },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "vertical_padding", "label": "Inside padding (top & bottom)", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Boxed" },
        { "value": "page-wide", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Gap above section",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "normal"
    }
  ],
  "blocks": [
    {
      "type": "decoration",
      "name": "Background element",
      "settings": [
        { "type": "paragraph", "content": "A faint illustration placed behind the text. Use an image, or a theme asset filename." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset", "label": "Theme asset filename", "info": "e.g. ourstory-paws.png (used when no image is picked)." },
        { "type": "range", "id": "x", "label": "Horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "y", "label": "Vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "width", "label": "Size", "min": 40, "max": 700, "step": 10, "unit": "px", "default": 180 },
        { "type": "range", "id": "mobile_scale", "label": "Mobile scale", "min": 20, "max": 120, "step": 5, "unit": "%", "default": 70 },
        { "type": "range", "id": "rotation", "label": "Rotation", "min": -180, "max": 180, "step": 5, "unit": "°", "default": 0 },
        { "type": "range", "id": "opacity", "label": "Opacity", "min": 3, "max": 100, "step": 1, "unit": "%", "default": 16 },
        { "type": "checkbox", "id": "flip_x", "label": "Flip horizontally", "default": false },
        { "type": "checkbox", "id": "show_desktop", "label": "Show on desktop", "default": true },
        { "type": "checkbox", "id": "show_mobile", "label": "Show on mobile", "default": true }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Waggly prose" }
  ]
}
{% endschema %}
