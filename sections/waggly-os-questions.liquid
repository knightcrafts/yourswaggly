{%- liquid
  assign s = section.settings
  assign q_img = ''
  if s.image != blank
    assign q_img = s.image | image_url: width: 400
  elsif s.image_asset != blank
    assign q_img = s.image_asset | asset_url
  endif
  assign banner_img = ''
  if s.banner_image != blank
    assign banner_img = s.banner_image | image_url: width: 2172
  elsif s.banner_asset != blank
    assign banner_img = s.banner_asset | asset_url
  endif
-%}

<section class="waggly-os-questions top-spacing-{{ s.top_spacing }}" style="--os-bg: {{ s.bg_color }}; --os-mark: {{ s.mark_color }}; --os-pad: {{ s.vertical_padding }}px; --os-doodle: {{ s.mark_color }};">
  {%- if s.show_doodles and banner_img == blank -%}
    <div class="waggly-os-questions__doodles" aria-hidden="true">
      <svg class="waggly-os-questions__doodle waggly-os-questions__doodle--1" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z"/></svg>
      <svg class="waggly-os-questions__doodle waggly-os-questions__doodle--2" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z"/></svg>
      <svg class="waggly-os-questions__doodle waggly-os-questions__doodle--3" viewBox="0 0 60 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-dasharray="3 7"><path d="M2 14C14 2 30 2 42 10s14 6 16 2"/></svg>
    </div>
  {%- endif -%}
  <div class="waggly-os-questions__wrap">
    {%- if banner_img != blank -%}
      <div class="waggly-os-questions__banner">
        <img src="{{ banner_img }}" alt="{{ s.banner_image.alt | default: 'Yours Waggly' | escape }}" loading="lazy">
      </div>
    {%- endif -%}
    <div class="waggly-os-questions__intro">
      {%- if banner_img == blank and q_img != blank -%}
        <div class="waggly-os-questions__kitten">
          <img src="{{ q_img }}" alt="{{ s.image.alt | default: 'Yours Waggly kitten' | escape }}" loading="lazy">
        </div>
      {%- endif -%}
      {%- if s.eyebrow != blank -%}<span class="waggly-os-questions__kicker">{{ s.eyebrow | escape }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="waggly-os-questions__heading">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.subtext != blank -%}<p class="waggly-os-questions__subtext">{{ s.subtext | escape }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="waggly-os-questions__grid">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="waggly-os-questions__q" {{ block.shopify_attributes }}>
            <span class="waggly-os-questions__mark" aria-hidden="true">{{ b.mark | default: '?' | escape }}</span>
            {%- if b.text != blank -%}<p>{{ b.text | escape }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.waggly-os-questions {
  --os-navy: #0D386F;
  --os-navy2: #4A5D80;
  --os-line: #F6D6DE;
  background: var(--os-bg, #FFF4F5);
  padding: var(--os-pad, 76px) 0;
  color: var(--os-navy);
  position: relative;
  overflow: hidden;
}
.waggly-os-questions__doodles { position: absolute; inset: 0; pointer-events: none; color: var(--os-doodle, #E83D74); }
.waggly-os-questions__doodle { position: absolute; }
.waggly-os-questions__doodle--1 { width: 24px; height: 24px; top: 20%; left: 8%; opacity: .55; transform: rotate(-10deg); }
.waggly-os-questions__doodle--2 { width: 18px; height: 18px; top: 30%; right: 9%; opacity: .45; transform: rotate(12deg); }
.waggly-os-questions__doodle--3 { width: 90px; height: 30px; top: 16%; right: 16%; opacity: .4; }
.waggly-os-questions__wrap { position: relative; max-width: 1120px; margin: 0 auto; padding: 0 20px; }
.waggly-os-questions__intro { max-width: 760px; margin: 0 auto; text-align: center; }
.waggly-os-questions__kitten {
  width: 170px;
  height: 170px;
  border-radius: 50%;
  overflow: hidden;
  margin: 0 auto 22px;
  border: 6px solid #fff;
  box-shadow: 0 10px 26px rgba(232, 61, 116, .2);
}
.waggly-os-questions__kitten img { display: block; width: 100%; height: 100%; object-fit: cover; }
.waggly-os-questions__banner { max-width: 660px; margin: 0 auto 6px; }
.waggly-os-questions__banner img { display: block; width: 100%; height: auto; }
.waggly-os-questions__kicker {
  display: inline-block;
  font-family: var(--font-body-family);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--os-mark, #E83D74);
  margin-bottom: 12px;
}
.waggly-os-questions__heading {
  font-family: var(--font-heading-family);
  font-weight: 800;
  line-height: 1.15;
  color: var(--os-navy);
  font-size: clamp(28px, 3.6vw, 40px);
  margin: 0 0 18px;
}
.waggly-os-questions__subtext { color: var(--os-navy2); line-height: 1.65; margin: 0; }
.waggly-os-questions__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-top: 34px;
}
.waggly-os-questions__q {
  background: #fff;
  border: 1px solid var(--os-line);
  border-radius: 22px;
  padding: 26px 22px;
  position: relative;
  text-align: left;
}
.waggly-os-questions__mark {
  display: block;
  font-family: var(--font-heading-family);
  font-size: 44px;
  font-weight: 800;
  color: var(--os-mark, #E83D74);
  line-height: 1;
  margin-bottom: 10px;
}
.waggly-os-questions__q p {
  color: var(--os-navy);
  font-weight: 600;
  font-size: 17px;
  margin: 0;
  line-height: 1.4;
}

@media (max-width: 900px) {
  .waggly-os-questions__grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 520px) {
  .waggly-os-questions__grid { grid-template-columns: 1fr; }
  .waggly-os-questions__doodles { display: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly OS questions",
  "tag": "section",
  "class": "waggly-os-questions-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Circle image (optional)" },
    { "type": "text", "id": "image_asset", "label": "or theme-asset filename", "info": "Fallback when no image is picked, e.g. os-questions-kitten.png." },
    { "type": "image_picker", "id": "banner_image", "label": "Full banner image (replaces the circle)", "info": "A wide graphic with the circle + decorations baked in. When set, it overrides the circle image and hides the section's own doodles." },
    { "type": "text", "id": "banner_asset", "label": "or banner theme-asset filename", "info": "e.g. os-questions-banner.png." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "It made us curious" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We found this change interesting." },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "So we started asking questions." },
    { "type": "checkbox", "id": "show_doodles", "label": "Show hand-drawn doodles", "default": true },
    { "type": "header", "content": "Colours & spacing" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFF4F5" },
    { "type": "color", "id": "mark_color", "label": "Accent (pink)", "default": "#E83D74" },
    { "type": "range", "id": "vertical_padding", "label": "Top & bottom padding", "min": 40, "max": 120, "step": 4, "unit": "px", "default": 76 },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Gap above section",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "mark", "label": "Mark", "default": "?" },
        { "type": "textarea", "id": "text", "label": "Question", "default": "What is changing in the way people see pets?" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Waggly OS questions",
      "blocks": [
        { "type": "question", "settings": { "text": "What is changing in the way people see pets?" } },
        { "type": "question", "settings": { "text": "What are pet parents looking for?" } },
        { "type": "question", "settings": { "text": "What does this mean for the pet industry?" } },
        { "type": "question", "settings": { "text": "How will the role of pets evolve in the years ahead?" } }
      ]
    }
  ]
}
{% endschema %}
