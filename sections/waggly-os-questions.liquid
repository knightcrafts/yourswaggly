{%- liquid
  assign s = section.settings
-%}

<section class="waggly-os-questions top-spacing-{{ s.top_spacing }}" style="--os-bg: {{ s.bg_color }}; --os-mark: {{ s.mark_color }}; --os-pad: {{ s.vertical_padding }}px;">
  <div class="waggly-os-questions__wrap">
    <div class="waggly-os-questions__intro">
      {%- if s.image != blank -%}
        <div class="waggly-os-questions__kitten">
          <img src="{{ s.image | image_url: width: 400 }}" width="{{ s.image.width }}" height="{{ s.image.height }}" alt="{{ s.image.alt | escape }}" loading="lazy">
        </div>
      {%- endif -%}
      {%- if s.eyebrow != blank -%}<span class="waggly-os-questions__kicker">{{ s.eyebrow | escape }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="waggly-os-questions__heading">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.subtext != blank -%}<p class="waggly-os-questions__subtext">{{ s.subtext | escape }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="waggly-os-questions__grid">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="waggly-os-questions__q" {{ block.shopify_attributes }}>
            <span class="waggly-os-questions__mark" aria-hidden="true">{{ b.mark | default: '?' | escape }}</span>
            {%- if b.text != blank -%}<p>{{ b.text | escape }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.waggly-os-questions {
  --os-navy: #0D386F;
  --os-navy2: #4A5D80;
  --os-line: #F6D6DE;
  background: var(--os-bg, #FFF4F5);
  padding: var(--os-pad, 76px) 0;
  color: var(--os-navy);
}
.waggly-os-questions__wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
.waggly-os-questions__intro { max-width: 760px; margin: 0 auto; text-align: center; }
.waggly-os-questions__kitten {
  width: 170px;
  height: 170px;
  border-radius: 50%;
  overflow: hidden;
  margin: 0 auto 22px;
  border: 6px solid #fff;
  box-shadow: 0 10px 26px rgba(232, 61, 116, .2);
}
.waggly-os-questions__kitten img { display: block; width: 100%; height: 100%; object-fit: cover; }
.waggly-os-questions__kicker {
  display: inline-block;
  font-family: var(--font-body-family);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--os-mark, #E83D74);
  margin-bottom: 12px;
}
.waggly-os-questions__heading {
  font-family: var(--font-heading-family);
  font-weight: 800;
  line-height: 1.15;
  color: var(--os-navy);
  font-size: clamp(28px, 3.6vw, 40px);
  margin: 0 0 18px;
}
.waggly-os-questions__subtext { color: var(--os-navy2); line-height: 1.65; margin: 0; }
.waggly-os-questions__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-top: 34px;
}
.waggly-os-questions__q {
  background: #fff;
  border: 1px solid var(--os-line);
  border-radius: 22px;
  padding: 26px 22px;
  position: relative;
  text-align: left;
}
.waggly-os-questions__mark {
  display: block;
  font-family: var(--font-heading-family);
  font-size: 44px;
  font-weight: 800;
  color: var(--os-mark, #E83D74);
  line-height: 1;
  margin-bottom: 10px;
}
.waggly-os-questions__q p {
  color: var(--os-navy);
  font-weight: 600;
  font-size: 17px;
  margin: 0;
  line-height: 1.4;
}

@media (max-width: 900px) {
  .waggly-os-questions__grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 520px) {
  .waggly-os-questions__grid { grid-template-columns: 1fr; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly OS questions",
  "tag": "section",
  "class": "waggly-os-questions-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Circle image (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "It made us curious" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We found this change interesting." },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "So we started asking questions." },
    { "type": "header", "content": "Colours & spacing" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFF4F5" },
    { "type": "color", "id": "mark_color", "label": "Accent (pink)", "default": "#E83D74" },
    { "type": "range", "id": "vertical_padding", "label": "Top & bottom padding", "min": 40, "max": 120, "step": 4, "unit": "px", "default": 76 },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Gap above section",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "mark", "label": "Mark", "default": "?" },
        { "type": "textarea", "id": "text", "label": "Question", "default": "What is changing in the way people see pets?" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Waggly OS questions",
      "blocks": [
        { "type": "question", "settings": { "text": "What is changing in the way people see pets?" } },
        { "type": "question", "settings": { "text": "What are pet parents looking for?" } },
        { "type": "question", "settings": { "text": "What does this mean for the pet industry?" } },
        { "type": "question", "settings": { "text": "How will the role of pets evolve in the years ahead?" } }
      ]
    }
  ]
}
{% endschema %}
