{%- liquid
  assign s = section.settings
-%}

<section class="waggly-os-shape top-spacing-{{ s.top_spacing }}" style="--os-dot: {{ s.dot_color }}; --os-line: {{ s.line_color }}; --os-pink: {{ s.accent_color }}; --os-doodle: {{ s.accent_color }};">
  {%- if s.image != blank -%}
    <div class="waggly-os-shape__photo" aria-hidden="true">
      <img src="{{ s.image | image_url: width: 700 }}" width="{{ s.image.width }}" height="{{ s.image.height }}" alt="{{ s.image.alt | escape }}" loading="lazy">
    </div>
  {%- endif -%}
  {%- if s.show_doodles -%}
    <div class="waggly-os-shape__doodles" aria-hidden="true">
      <svg class="waggly-os-shape__doodle waggly-os-shape__doodle--1" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z"/></svg>
      <svg class="waggly-os-shape__doodle waggly-os-shape__doodle--2" viewBox="0 0 28 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 8c3-6 6 4 9-1s6-5 9 1"/></svg>
    </div>
  {%- endif -%}
  <div class="waggly-os-shape__wrap waggly-os-shape__grid">
    {%- if section.blocks.size > 0 -%}
      <div class="waggly-os-shape__evolve" aria-label="{{ s.evolve_label | escape }}">
        <div class="waggly-os-shape__trail" aria-hidden="true"></div>
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="waggly-os-shape__row" {{ block.shopify_attributes }}>
            <div class="waggly-os-shape__dot" aria-hidden="true">
              {%- if b.svg_code != blank -%}{{ b.svg_code }}{%- endif -%}
            </div>
            {%- if b.label != blank -%}<b>{{ b.label | escape }}</b>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="waggly-os-shape__text">
      {%- if s.eyebrow != blank -%}<span class="waggly-os-shape__kicker">{{ s.eyebrow | escape }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="waggly-os-shape__heading">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.body != blank -%}<div class="waggly-os-shape__body rte">{{ s.body }}</div>{%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.waggly-os-shape {
  --os-navy: #0D386F;
  --os-navy2: #4A5D80;
  padding: 76px 0;
  color: var(--os-navy);
  position: relative;
  overflow: hidden;
}
.waggly-os-shape__photo {
  position: absolute;
  right: 0;
  bottom: 0;
  width: clamp(180px, 20vw, 300px);
  z-index: 0;
  pointer-events: none;
}
.waggly-os-shape__photo img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
  filter: drop-shadow(0 14px 26px rgba(13, 56, 111, .14));
}
.waggly-os-shape__doodles { position: absolute; inset: 0; pointer-events: none; color: var(--os-doodle, #E83D74); }
.waggly-os-shape__doodle { position: absolute; opacity: .55; }
.waggly-os-shape__doodle--1 { width: 22px; height: 22px; top: 18%; right: 20%; transform: rotate(-8deg); }
.waggly-os-shape__doodle--2 { width: 30px; height: 15px; bottom: 24%; right: 24%; opacity: .45; }
.waggly-os-shape__wrap { position: relative; z-index: 1; max-width: 1120px; margin: 0 auto; padding: 0 20px; }
.waggly-os-shape__grid {
  display: grid;
  grid-template-columns: .9fr 1.1fr;
  gap: 56px;
  align-items: center;
}
.waggly-os-shape__evolve { position: relative; padding: 8px 0; }
.waggly-os-shape__trail {
  position: absolute;
  left: 27px;
  top: 40px;
  bottom: 40px;
  border-left: 2px dashed var(--os-pink, #E83D74);
  opacity: .5;
  z-index: 0;
}
.waggly-os-shape__row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 18px;
}
.waggly-os-shape__row:last-child { margin-bottom: 0; }
.waggly-os-shape__dot {
  flex: 0 0 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--os-dot, #0D386F);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.waggly-os-shape__dot svg { width: 26px; height: 26px; }
.waggly-os-shape__row b { font-size: 18px; font-weight: 700; color: var(--os-navy); }
.waggly-os-shape__kicker {
  display: inline-block;
  font-family: var(--font-body-family);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--os-pink, #E83D74);
  margin-bottom: 12px;
}
.waggly-os-shape__heading {
  font-family: var(--font-heading-family);
  font-weight: 800;
  line-height: 1.15;
  color: var(--os-navy);
  font-size: clamp(28px, 3.6vw, 40px);
  margin: 0 0 18px;
}
.waggly-os-shape__body { color: var(--os-navy2); line-height: 1.65; }
.waggly-os-shape__body p { margin: 0 0 16px; }
.waggly-os-shape__body p:last-child { margin-bottom: 0; }

@media (max-width: 900px) {
  .waggly-os-shape { padding: 56px 0; }
  .waggly-os-shape__grid { grid-template-columns: 1fr; gap: 32px; }
  .waggly-os-shape__photo,
  .waggly-os-shape__doodles { display: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly OS shape",
  "tag": "section",
  "class": "waggly-os-shape-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How Yours Waggly took shape" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A closer look at the world of pets" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>That curiosity led us to explore the world of pets more closely, and somewhere along the way, the idea of Yours Waggly took shape.</p><p>We believe pets will play an even more meaningful role in the lives of the coming generation. As that relationship evolves, so will the way we care for them, feed them, keep them healthy and choose products for them.</p>" },
    { "type": "text", "id": "evolve_label", "label": "Timeline accessible label", "default": "What will evolve" },
    { "type": "header", "content": "Decoration" },
    { "type": "image_picker", "id": "image", "label": "Side photo (transparent cutout)", "info": "Bleeds in from the right; hidden on mobile." },
    { "type": "checkbox", "id": "show_doodles", "label": "Show hand-drawn doodles", "default": true },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "dot_color", "label": "Dot background", "default": "#0D386F" },
    { "type": "color", "id": "line_color", "label": "Dashed line", "default": "#E83D74" },
    { "type": "color", "id": "accent_color", "label": "Accent (pink)", "default": "#E83D74" },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Gap above section",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "How we care for them" },
        { "type": "html", "id": "svg_code", "label": "Icon SVG" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Waggly OS shape",
      "blocks": [
        { "type": "milestone", "settings": { "label": "How we care for them", "svg_code": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z\"/></svg>" } },
        { "type": "milestone", "settings": { "label": "How we feed them", "svg_code": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 11h16a8 8 0 0 1-16 0z\"/><path d=\"M9 7c0-1 1-2 3-2s3 1 3 2\"/></svg>" } },
        { "type": "milestone", "settings": { "label": "How we keep them healthy", "svg_code": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 3h4v7h7v4h-7v7h-4v-7H3v-4h7z\"/></svg>" } },
        { "type": "milestone", "settings": { "label": "How we choose products for them", "svg_code": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 2l-3 4v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z\"/><path d=\"M3 6h18M16 10a4 4 0 0 1-8 0\"/></svg>" } }
      ]
    }
  ]
}
{% endschema %}
