{%- liquid
  assign s = section.settings
  assign heading_tag = s.heading_tag | default: 'h2'
-%}

<section class="waggly-story top-spacing-{{ s.top_spacing }}" style="--wg-story-bg: {{ s.bg_color }};">
  <div class="{% if s.width == 'page-width' %}page-width{% else %}page-wide{% endif %}">
    {%- if s.is_quote -%}
      <blockquote class="waggly-story__quote">
        {%- if s.body != blank -%}<div class="rte">{{ s.body }}</div>{%- endif -%}
        {%- if s.quote_author != blank -%}<cite class="waggly-story__cite">{{ s.quote_author | escape }}</cite>{%- endif -%}
      </blockquote>
    {%- else -%}
      <div class="waggly-story__grid{% if s.image != blank %} waggly-story__grid--split{% endif %}{% if s.image_position == 'left' %} waggly-story__grid--reverse{% endif %}{% if s.align == 'center' %} waggly-story__grid--center{% endif %}">
        <div class="waggly-story__content">
          {%- if s.eyebrow != blank -%}<p class="waggly-story__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<{{ heading_tag }} class="waggly-story__heading">{{ s.heading | escape }}</{{ heading_tag }}>{%- endif -%}
          {%- if s.body != blank -%}<div class="waggly-story__body rte">{{ s.body }}</div>{%- endif -%}
          {%- if s.button_label != blank -%}
            <a class="waggly-story__btn"{% if s.button_link != blank %} href="{{ s.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>{{ s.button_label | escape }}</a>
          {%- endif -%}
        </div>

        {%- if s.image != blank -%}
          <div class="waggly-story__media">
            {%- assign img = s.image -%}
            <img
              class="waggly-story__image"
              src="{{ img | image_url: width: 800 }}"
              srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1100 }} 1100w"
              sizes="(min-width: 990px) 46vw, 90vw"
              width="{{ img.width }}"
              height="{{ img.height }}"
              alt="{{ img.alt | escape }}"
              loading="lazy">
          </div>
        {%- elsif s.show_image_placeholder -%}
          <div class="waggly-story__media">
            <div class="waggly-story__image waggly-story__image--placeholder">{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.waggly-story { background: var(--wg-story-bg, transparent); }
.waggly-story__grid { display: grid; grid-template-columns: 1fr; gap: 30px; align-items: center; }
.waggly-story__grid--split { grid-template-columns: 1fr 1fr; }
.waggly-story__grid--center { text-align: center; justify-items: center; }
.waggly-story__eyebrow {
  font-family: var(--font-body-family);
  font-weight: 600;
  font-size: .9rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin: 0 0 12px;
}
.waggly-story__heading {
  font-family: var(--font-heading-family);
  font-weight: 700;
  color: var(--color-base);
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  margin: 0 0 16px;
}
.waggly-story__body { color: var(--color-base); max-width: 62ch; }
.waggly-story__grid--center .waggly-story__body { margin-inline: auto; }
.waggly-story__body p { margin: 0 0 1em; }
.waggly-story__body p:last-child { margin-bottom: 0; }
.waggly-story__btn {
  display: inline-flex;
  align-items: center;
  min-height: 50px;
  padding: 0 26px;
  margin-top: 22px;
  border-radius: 999px;
  background: var(--color-accent);
  color: #fff;
  font-weight: 600;
  text-decoration: none;
  transition: transform var(--duration-short, .2s) ease;
}
.waggly-story__btn:hover { transform: translateY(-2px); }
.waggly-story__btn[aria-disabled="true"] { opacity: .5; pointer-events: none; }
.waggly-story__media { display: flex; justify-content: center; }
.waggly-story__image { max-width: 100%; height: auto; display: block; border-radius: 24px; }
.waggly-story__image--placeholder { width: 100%; overflow: hidden; }
.waggly-story__image--placeholder .placeholder-svg { width: 100%; height: auto; display: block; background: rgba(0,0,0,.05); }

.waggly-story__quote {
  margin: 0 auto;
  max-width: 40ch;
  text-align: center;
  font-family: 'Kalam', cursive;
  color: var(--color-base);
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  line-height: 1.35;
}
.waggly-story__quote .rte p { margin: 0; }
.waggly-story__cite {
  display: block;
  margin-top: 16px;
  font-family: var(--font-body-family);
  font-style: normal;
  font-size: .95rem;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--color-accent);
}

@media (max-width: 989px) {
  .waggly-story__grid--split { grid-template-columns: 1fr; text-align: center; }
  .waggly-story__grid--split .waggly-story__body { margin-inline: auto; }
  .waggly-story__grid--reverse .waggly-story__media { order: -1; }
  .waggly-story__media { max-width: 480px; margin-inline: auto; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly story",
  "tag": "section",
  "class": "waggly-story-section",
  "settings": [
    { "type": "checkbox", "id": "is_quote", "label": "Show as centered quote", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    { "type": "richtext", "id": "body", "label": "Text", "default": "<p>Share your story here.</p>" },
    { "type": "text", "id": "quote_author", "label": "Quote attribution", "info": "Only used when 'Show as centered quote' is on." },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "show_image_placeholder", "label": "Show placeholder when no image", "default": true },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment (no image)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Boxed" },
        { "value": "page-wide", "label": "Full width" }
      ],
      "default": "page-width"
    },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "rgba(0,0,0,0)" },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "normal"
    }
  ],
  "presets": [
    { "name": "Waggly story" }
  ]
}
{% endschema %}
