{%- liquid
  assign s = section.settings
  assign pills = section.blocks | where: 'type', 'pill'
  assign pillars = section.blocks | where: 'type', 'pillar'
-%}

<section class="waggly-os-marketplace top-spacing-{{ s.top_spacing }}" style="--os-pink: {{ s.accent_color }}; --os-doodle: {{ s.accent_color }};">
  {%- if s.image_left != blank -%}
    <div class="waggly-os-marketplace__photo waggly-os-marketplace__photo--left" aria-hidden="true">
      <img src="{{ s.image_left | image_url: width: 600 }}" width="{{ s.image_left.width }}" height="{{ s.image_left.height }}" alt="" loading="lazy">
    </div>
  {%- endif -%}
  {%- if s.image_right != blank -%}
    <div class="waggly-os-marketplace__photo waggly-os-marketplace__photo--right" aria-hidden="true">
      <img src="{{ s.image_right | image_url: width: 600 }}" width="{{ s.image_right.width }}" height="{{ s.image_right.height }}" alt="" loading="lazy">
    </div>
  {%- endif -%}
  {%- if s.show_doodles -%}
    <div class="waggly-os-marketplace__doodles" aria-hidden="true">
      <svg class="waggly-os-marketplace__doodle waggly-os-marketplace__doodle--1" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z"/></svg>
      <svg class="waggly-os-marketplace__doodle waggly-os-marketplace__doodle--2" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z"/></svg>
    </div>
  {%- endif -%}
  <div class="waggly-os-marketplace__wrap">
    <div class="waggly-os-marketplace__intro">
      {%- if s.eyebrow != blank -%}<span class="waggly-os-marketplace__kicker">{{ s.eyebrow | escape }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="waggly-os-marketplace__heading">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if pills.size > 0 -%}
        <div class="waggly-os-marketplace__notjust">
          {%- for block in pills -%}
            <span {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if s.subtext != blank -%}<p class="waggly-os-marketplace__subtext">{{ s.subtext | escape }}</p>{%- endif -%}
    </div>

    {%- if pillars.size > 0 -%}
      <div class="waggly-os-marketplace__pillars">
        {%- for block in pillars -%}
          {%- assign b = block.settings -%}
          <div class="waggly-os-marketplace__pillar" {{ block.shopify_attributes }}>
            <div class="waggly-os-marketplace__ic" aria-hidden="true">
              {%- if b.svg_code != blank -%}{{ b.svg_code }}{%- endif -%}
            </div>
            {%- if b.title != blank -%}<h3>{{ b.title | escape }}</h3>{%- endif -%}
            {%- if b.text != blank -%}<p>{{ b.text | escape }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.waggly-os-marketplace {
  --os-navy: #0D386F;
  --os-navy2: #4A5D80;
  --os-line: #F6D6DE;
  --os-pinkS: #FDE4EA;
  padding: 76px 0;
  color: var(--os-navy);
  position: relative;
  overflow: hidden;
}
.waggly-os-marketplace__photo {
  position: absolute;
  bottom: 0;
  width: clamp(140px, 15vw, 230px);
  z-index: 0;
  pointer-events: none;
}
.waggly-os-marketplace__photo--left { left: 0; }
.waggly-os-marketplace__photo--right { right: 0; }
.waggly-os-marketplace__photo img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
  filter: drop-shadow(0 14px 26px rgba(13, 56, 111, .12));
}
.waggly-os-marketplace__doodles { position: absolute; inset: 0; pointer-events: none; color: var(--os-doodle, #E83D74); }
.waggly-os-marketplace__doodle { position: absolute; opacity: .5; }
.waggly-os-marketplace__doodle--1 { width: 22px; height: 22px; top: 24%; left: 16%; transform: rotate(-10deg); }
.waggly-os-marketplace__doodle--2 { width: 18px; height: 18px; top: 30%; right: 17%; transform: rotate(12deg); }
.waggly-os-marketplace__wrap { position: relative; z-index: 1; max-width: 1120px; margin: 0 auto; padding: 0 20px; }
.waggly-os-marketplace__intro { max-width: 760px; margin: 0 auto; text-align: center; }
.waggly-os-marketplace__kicker {
  display: inline-block;
  font-family: var(--font-body-family);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--os-pink, #E83D74);
  margin-bottom: 12px;
}
.waggly-os-marketplace__heading {
  font-family: var(--font-heading-family);
  font-weight: 800;
  line-height: 1.15;
  color: var(--os-navy);
  font-size: clamp(28px, 3.6vw, 40px);
  margin: 0 0 18px;
}
.waggly-os-marketplace__notjust {
  display: flex;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 6px;
}
.waggly-os-marketplace__notjust span {
  font-size: 14px;
  font-weight: 600;
  padding: 5px 14px;
  border-radius: 999px;
  background: #EEF1F6;
  color: var(--os-navy2);
  text-decoration: line-through;
  text-decoration-color: var(--os-pink, #E83D74);
  text-decoration-thickness: 2px;
}
.waggly-os-marketplace__subtext { color: var(--os-navy2); line-height: 1.65; margin: 18px 0 0; }
.waggly-os-marketplace__pillars {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  margin-top: 34px;
}
.waggly-os-marketplace__pillar {
  background: #fff;
  border: 1px solid var(--os-line);
  border-radius: 24px;
  padding: 30px 26px;
  text-align: left;
}
.waggly-os-marketplace__ic {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: var(--os-pinkS);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18px;
  color: var(--os-pink, #E83D74);
}
.waggly-os-marketplace__ic svg { width: 28px; height: 28px; }
.waggly-os-marketplace__pillar h3 {
  font-family: var(--font-heading-family);
  font-weight: 700;
  font-size: 19px;
  margin: 0 0 6px;
  color: var(--os-navy);
  line-height: 1.25;
}
.waggly-os-marketplace__pillar p { font-size: 16px; margin: 0; color: var(--os-navy2); line-height: 1.6; }

@media (max-width: 900px) {
  .waggly-os-marketplace { padding: 56px 0; }
  .waggly-os-marketplace__pillars { grid-template-columns: 1fr; }
  .waggly-os-marketplace__photo,
  .waggly-os-marketplace__doodles { display: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly OS marketplace",
  "tag": "section",
  "class": "waggly-os-marketplace-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What we want to be" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More than a marketplace" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Rather than simply selling products, we wanted Yours Waggly to be a place that:" },
    { "type": "header", "content": "Decoration" },
    { "type": "image_picker", "id": "image_left", "label": "Left photo (transparent cutout)", "info": "Bleeds in from the left; hidden on mobile." },
    { "type": "image_picker", "id": "image_right", "label": "Right photo (transparent cutout)", "info": "Bleeds in from the right; hidden on mobile." },
    { "type": "checkbox", "id": "show_doodles", "label": "Show hand-drawn doodles", "default": true },
    { "type": "color", "id": "accent_color", "label": "Accent (pink)", "default": "#E83D74" },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Gap above section",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Struck pill",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Just another store" }
      ]
    },
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shares insights" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "On what is good for our pets, through guides and the Yours Waggly Academy." },
        { "type": "html", "id": "svg_code", "label": "Icon SVG" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Waggly OS marketplace",
      "blocks": [
        { "type": "pill", "settings": { "text": "Just another store" } },
        { "type": "pill", "settings": { "text": "Just another marketplace" } },
        { "type": "pillar", "settings": { "title": "Shares insights", "text": "On what is good for our pets, through guides and the Yours Waggly Academy.", "svg_code": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#E83D74\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2 4h7a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H2zM22 4h-7a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h8z\"/></svg>" } },
        { "type": "pillar", "settings": { "title": "Identifies what’s genuinely useful", "text": "Cutting through the noise so you can choose with confidence.", "svg_code": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#E83D74\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 11l3 3 8-8\"/><path d=\"M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9\"/></svg>" } },
        { "type": "pillar", "settings": { "title": "Brings together what’s worth considering", "text": "A thoughtful selection for every wag and purr.", "svg_code": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#E83D74\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2l2.5 6.5L21 9l-5 4.5L17.5 21 12 17l-5.5 4L8 13.5 3 9l6.5-.5z\"/></svg>" } }
      ]
    }
  ]
}
{% endschema %}
