{%- liquid
  assign s = section.settings
  assign tiers = section.blocks | where: 'type', 'tier'
  assign lines = section.blocks | where: 'type', 'line'
-%}

<section class="waggly-pricing top-spacing-{{ s.top_spacing }}">
  <div class="{% if s.width == 'page-wide' %}page-wide{% else %}page-width{% endif %}">
    {%- if s.eyebrow != blank or s.heading != blank or s.subtext != blank -%}
      <header class="waggly-pricing__head">
        {%- if s.eyebrow != blank -%}<p class="waggly-pricing__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="waggly-pricing__heading{% if s.heading_style == 'handwritten' %} waggly-pricing__heading--hand{% endif %}">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.subtext != blank -%}<div class="waggly-pricing__subtext rte">{{ s.subtext }}</div>{%- endif -%}
      </header>
    {%- endif -%}

    {%- if tiers.size > 0 -%}
      <div class="waggly-pricing__tiers" style="--tier-cols: {{ tiers.size | at_most: 4 }};">
        {%- for block in tiers -%}
          {%- assign b = block.settings -%}
          <article class="waggly-pricing__tier{% if b.highlight %} is-highlight{% endif %}" {{ block.shopify_attributes }}>
            {%- if b.highlight and b.highlight_label != blank -%}
              <span class="waggly-pricing__flag">{{ b.highlight_label | escape }}</span>
            {%- endif -%}
            {%- if b.name != blank -%}<h3 class="waggly-pricing__tier-name">{{ b.name | escape }}</h3>{%- endif -%}
            {%- if b.tagline != blank -%}<p class="waggly-pricing__tier-tag">{{ b.tagline | escape }}</p>{%- endif -%}
            {%- if b.price != blank -%}<p class="waggly-pricing__price">{{ b.price | escape }}</p>{%- endif -%}
            {%- if b.note != blank -%}<p class="waggly-pricing__note">{{ b.note | escape }}</p>{%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.example_heading != blank or lines.size > 0 -%}
      <div class="waggly-pricing__example">
        {%- if s.example_eyebrow != blank -%}<p class="waggly-pricing__ex-eyebrow">{{ s.example_eyebrow | escape }}</p>{%- endif -%}
        {%- if s.example_heading != blank -%}<h3 class="waggly-pricing__ex-heading">{{ s.example_heading | escape }}</h3>{%- endif -%}
        {%- if s.example_intro != blank -%}<p class="waggly-pricing__ex-intro">{{ s.example_intro | escape }}</p>{%- endif -%}
        {%- if lines.size > 0 -%}
          <ul class="waggly-pricing__lines" role="list">
            {%- for block in lines -%}
              {%- assign b = block.settings -%}
              <li class="waggly-pricing__line{% if b.is_total %} is-total{% endif %}" {{ block.shopify_attributes }}>
                <span class="waggly-pricing__line-label">{{ b.label | escape }}</span>
                <span class="waggly-pricing__line-value">{{ b.value | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.waggly-pricing__head { text-align: center; margin-bottom: 30px; }
.waggly-pricing__eyebrow {
  font-family: var(--font-body-family);
  font-weight: 600;
  font-size: .85rem;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin: 0 0 8px;
}
.waggly-pricing__heading {
  font-family: var(--font-heading-family);
  font-weight: 700;
  color: var(--color-base);
  font-size: clamp(1.8rem, 3.4vw, 2.8rem);
  margin: 0;
}
.waggly-pricing__heading--hand { font-family: 'Kalam', cursive; }
.waggly-pricing__subtext {
  max-width: 62ch;
  margin: 12px auto 0;
  color: var(--color-base);
  opacity: .82;
  line-height: 1.5;
}
.waggly-pricing__subtext p { margin: 0; }

.waggly-pricing__tiers {
  display: grid;
  grid-template-columns: repeat(var(--tier-cols, 3), minmax(0, 1fr));
  gap: 22px;
}
.waggly-pricing__tier {
  position: relative;
  background: #fff;
  border: 1px solid var(--color-lines-borders, #F6D6DE);
  border-radius: 24px;
  padding: 30px 28px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  box-shadow: 0 10px 28px rgba(13, 56, 111, .05);
}
.waggly-pricing__tier.is-highlight {
  border-color: var(--color-accent);
  border-width: 2px;
  box-shadow: 0 16px 36px rgba(232, 61, 116, .14);
}
.waggly-pricing__flag {
  position: absolute;
  top: -13px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--color-accent);
  color: #fff;
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .04em;
  text-transform: uppercase;
  padding: 5px 14px;
  border-radius: 999px;
  white-space: nowrap;
}
.waggly-pricing__tier-name {
  font-family: var(--font-heading-family);
  font-weight: 700;
  font-size: 1.3rem;
  color: var(--color-base);
  margin: 0;
}
.waggly-pricing__tier-tag { margin: 0; color: var(--color-base); opacity: .72; font-size: .92rem; line-height: 1.35; }
.waggly-pricing__price {
  font-family: var(--font-heading-family);
  font-weight: 800;
  font-size: clamp(1.5rem, 3vw, 1.9rem);
  color: var(--color-base);
  margin: 10px 0 0;
}
.waggly-pricing__note { margin: 0; font-size: .82rem; color: var(--color-base); opacity: .62; }

.waggly-pricing__example {
  margin-top: 28px;
  background: var(--color-secondary-background, #FDE4EA);
  border-radius: 24px;
  padding: 30px 32px;
  max-width: 620px;
  margin-inline: auto;
}
.waggly-pricing__ex-eyebrow {
  font-family: var(--font-body-family);
  font-weight: 600;
  font-size: .78rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin: 0 0 6px;
}
.waggly-pricing__ex-heading {
  font-family: var(--font-heading-family);
  font-weight: 700;
  font-size: 1.2rem;
  color: var(--color-base);
  margin: 0 0 6px;
}
.waggly-pricing__ex-intro { margin: 0 0 16px; color: var(--color-base); opacity: .8; font-size: .92rem; line-height: 1.45; }
.waggly-pricing__lines { list-style: none; margin: 0; padding: 0; }
.waggly-pricing__line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  padding: 11px 0;
  border-bottom: 1px dashed rgba(13, 56, 111, .18);
}
.waggly-pricing__line-label { color: var(--color-base); font-size: .95rem; }
.waggly-pricing__line-value { color: var(--color-base); font-weight: 600; white-space: nowrap; }
.waggly-pricing__line.is-total {
  border-bottom: none;
  border-top: 2px solid rgba(13, 56, 111, .22);
  margin-top: 6px;
  padding-top: 15px;
}
.waggly-pricing__line.is-total .waggly-pricing__line-label { font-weight: 700; font-size: 1.02rem; }
.waggly-pricing__line.is-total .waggly-pricing__line-value {
  color: var(--color-accent);
  font-family: var(--font-heading-family);
  font-weight: 800;
  font-size: 1.15rem;
}

@media (max-width: 989px) {
  .waggly-pricing__tiers { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; }
}
@media (max-width: 576px) {
  .waggly-pricing__example { padding: 24px 20px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly pricing",
  "tag": "section",
  "class": "waggly-pricing-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)", "default": "What it costs" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Protection for every budget" },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading style",
      "options": [
        { "value": "normal", "label": "Normal (Outfit)" },
        { "value": "handwritten", "label": "Handwritten (Kalam)" }
      ],
      "default": "normal"
    },
    { "type": "richtext", "id": "subtext", "label": "Text under heading (optional)" },
    { "type": "header", "content": "Example breakdown card (optional)", "info": "Shown below the tiers. Add 'Line item' blocks for the rows." },
    { "type": "text", "id": "example_eyebrow", "label": "Example eyebrow", "default": "Example" },
    { "type": "text", "id": "example_heading", "label": "Example heading" },
    { "type": "textarea", "id": "example_intro", "label": "Example intro" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Boxed" },
        { "value": "page-wide", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "normal"
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        { "type": "text", "id": "name", "label": "Tier name", "default": "Comprehensive" },
        { "type": "text", "id": "tagline", "label": "Tagline", "default": "Illness + accident + surgery" },
        { "type": "text", "id": "price", "label": "Price", "default": "₹2,000 – ₹10,000" },
        { "type": "text", "id": "note", "label": "Note under price", "default": "per year · right for most pets" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight this tier", "default": false },
        { "type": "text", "id": "highlight_label", "label": "Highlight pill text", "default": "Most popular" }
      ]
    },
    {
      "type": "line",
      "name": "Example line item",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Serious illness" },
        { "type": "text", "id": "value", "label": "Value", "default": "₹3,850" },
        { "type": "checkbox", "id": "is_total", "label": "Total row (emphasised)", "default": false }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Waggly pricing",
      "blocks": [
        { "type": "tier", "settings": { "name": "Basic", "tagline": "Surgery or accident only", "price": "₹315 – ₹2,000", "note": "per year · minimal cover", "highlight": false } },
        { "type": "tier", "settings": { "name": "Comprehensive", "tagline": "Illness + accident + surgery", "price": "₹2,000 – ₹10,000", "note": "per year · right for most pets", "highlight": true, "highlight_label": "Right for most pets" } },
        { "type": "tier", "settings": { "name": "Premium", "tagline": "Adds vet visits + liability", "price": "₹5,000 – ₹15,000+", "note": "per year · extensive cover", "highlight": false } }
      ]
    }
  ]
}
{% endschema %}
