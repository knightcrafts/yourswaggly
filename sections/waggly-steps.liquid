{%- liquid
  assign s = section.settings
-%}

<section class="waggly-steps top-spacing-{{ s.top_spacing }}" style="--wg-step-accent: {{ s.icon_bg }};">
  <div class="{% if s.width == 'page-width' %}page-width{% else %}page-wide{% endif %}">
    <div class="waggly-steps__layout">
      <div class="waggly-steps__intro">
        {%- if s.eyebrow != blank -%}<p class="waggly-steps__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="waggly-steps__heading">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.body != blank -%}<div class="waggly-steps__body rte">{{ s.body }}</div>{%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ol class="waggly-steps__flow">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            <li class="waggly-steps__step" {{ block.shopify_attributes }}>
              <span class="waggly-steps__icon" aria-hidden="true">
                {%- if b.svg_code != blank -%}{{ b.svg_code }}
                {%- elsif b.icon != blank -%}<img src="{{ b.icon | image_url: width: 80 }}" width="26" height="26" alt="" loading="lazy">
                {%- else -%}{{ forloop.index }}{%- endif -%}
              </span>
              {%- if b.title != blank -%}<span class="waggly-steps__title">{{ b.title | escape }}</span>{%- endif -%}
              {%- if b.description != blank -%}<span class="waggly-steps__desc">{{ b.description | escape }}</span>{%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.waggly-steps__layout {
  display: grid;
  grid-template-columns: 0.85fr 1.25fr;
  gap: 40px;
  align-items: center;
}
.waggly-steps__eyebrow {
  font-family: var(--font-body-family);
  font-weight: 600;
  font-size: .85rem;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin: 0 0 10px;
}
.waggly-steps__heading {
  font-family: var(--font-heading-family);
  font-weight: 700;
  color: var(--color-base);
  font-size: clamp(1.5rem, 2.6vw, 2rem);
  margin: 0 0 14px;
}
.waggly-steps__body { color: var(--color-base); }
.waggly-steps__body p { margin: 0 0 1em; }
.waggly-steps__body p:last-child { margin-bottom: 0; }

.waggly-steps__flow {
  position: relative;
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  gap: 14px;
}
.waggly-steps__flow::before {
  content: "";
  position: absolute;
  top: 27px;
  left: 10%;
  right: 10%;
  border-top: 2px dashed rgba(84, 67, 64, .25);
  z-index: 0;
}
.waggly-steps__step {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 10px;
}
.waggly-steps__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: var(--wg-step-accent, var(--color-accent));
  color: #fff;
  font-family: var(--font-heading-family);
  font-weight: 700;
}
.waggly-steps__icon img { width: 26px; height: 26px; object-fit: contain; }
.waggly-steps__title { font-family: var(--font-heading-family); font-weight: 700; color: var(--color-base); }
.waggly-steps__desc { font-size: var(--font-body3-size, 12px); line-height: 1.35; color: var(--color-base); opacity: .7; max-width: 18ch; }

@media (max-width: 989px) {
  .waggly-steps__layout { grid-template-columns: 1fr; gap: 28px; }
}
@media (max-width: 576px) {
  .waggly-steps__flow { flex-wrap: wrap; gap: 22px 14px; }
  .waggly-steps__flow::before { display: none; }
  .waggly-steps__step { flex: 0 0 calc(50% - 7px); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly steps",
  "tag": "section",
  "class": "waggly-steps-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Thinking" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text", "default": "<p>Our approach comes from where we have spent much of our professional lives — business consulting and financial advisory. Our work has taught us to ask questions, look beyond the obvious, research markets, evaluate choices and make decisions based on what truly creates value.</p><p><strong>We wanted to bring that same thinking into the pet industry.</strong></p>" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "icon_bg", "label": "Step icon colour", "default": "#9b643d" },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Boxed" },
        { "value": "page-wide", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "normal"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Research" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Ask questions and look beyond the obvious" },
        { "type": "image_picker", "id": "icon", "label": "Icon (optional)" },
        { "type": "html", "id": "svg_code", "label": "or inline SVG (optional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Waggly steps",
      "blocks": [
        { "type": "step", "settings": { "title": "Research", "description": "Ask questions and look beyond the obvious" } },
        { "type": "step", "settings": { "title": "Evaluate", "description": "Research markets and evaluate choices" } },
        { "type": "step", "settings": { "title": "Choose", "description": "Make decisions based on what truly creates value" } },
        { "type": "step", "settings": { "title": "Create Value", "description": "Invest in what is genuinely useful" } }
      ]
    }
  ]
}
{% endschema %}
