{%- liquid
  assign s = section.settings
-%}

<section class="waggly-faq top-spacing-{{ s.top_spacing }}{% if s.heading_style == 'handwritten' %} waggly-faq--hand{% endif %}" style="--wg-faq-row-bg: {{ s.row_bg }}; --wg-faq-img-radius: {{ s.image_radius | default: 24 }}px;{% if s.image_width > 0 %} --wg-faq-img-w: {{ s.image_width }}px;{% endif %}">
  <div class="{% if s.width == 'page-width' %}page-width{% else %}page-wide{% endif %} waggly-faq__inner">
    <div class="waggly-faq__aside">
      {%- if s.eyebrow != blank -%}
        <p class="waggly-faq__eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="waggly-faq__heading">
          {{ s.heading | escape }}
          {%- if s.show_paw -%}
            <svg class="waggly-faq__paw" viewBox="0 0 48 48" fill="currentColor" aria-hidden="true" focusable="false"><ellipse cx="24" cy="34" rx="12" ry="9"/><circle cx="10" cy="20" r="5"/><circle cx="20" cy="12" r="5"/><circle cx="32" cy="12" r="5"/><circle cx="40" cy="20" r="5"/></svg>
          {%- endif -%}
        </h2>
      {%- endif -%}
      {%- if s.subtext != blank -%}
        <div class="waggly-faq__text rte">{{ s.subtext }}</div>
      {%- endif -%}
      {%- if s.image != blank -%}
        <div class="waggly-faq__media">
          {%- assign img = s.image -%}
          <img
            class="waggly-faq__image"
            src="{{ img | image_url: width: 700 }}"
            srcset="{{ img | image_url: width: 350 }} 350w, {{ img | image_url: width: 700 }} 700w, {{ img | image_url: width: 1000 }} 1000w"
            sizes="(min-width: 990px) 38vw, 90vw"
            width="{{ img.width }}"
            height="{{ img.height }}"
            alt="{{ img.alt | escape }}"
            loading="lazy">
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="waggly-faq__list">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <details class="waggly-faq__item"{% if b.open %} open{% endif %} {{ block.shopify_attributes }}>
            <summary class="waggly-faq__q">
              <span>{{ b.question | escape }}</span>
              <svg class="waggly-faq__chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            {%- if b.answer != blank -%}
              <div class="waggly-faq__a rte">{{ b.answer }}</div>
            {%- endif -%}
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.waggly-faq__inner {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
  gap: 40px;
  align-items: start;
}
.waggly-faq__eyebrow {
  font-family: var(--font-body-family);
  font-weight: 600;
  font-size: .9rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin: 0 0 8px;
}
.waggly-faq__heading {
  font-family: var(--font-heading-family);
  font-weight: 700;
  font-size: clamp(1.9rem, 3.4vw, 2.8rem);
  color: var(--color-base);
  margin: 0;
  display: inline-flex;
  align-items: baseline;
  gap: 12px;
}
.waggly-faq--hand .waggly-faq__heading { font-family: 'Kalam', cursive; }
.waggly-faq__paw { width: 34px; height: 34px; color: var(--color-accent); opacity: .55; flex: 0 0 auto; align-self: center; }
.waggly-faq__text { margin-top: 16px; color: var(--color-base); opacity: .8; }
.waggly-faq__media { margin-top: 28px; }
.waggly-faq__image { width: 100%; max-width: var(--wg-faq-img-w, 100%); height: auto; display: block; border-radius: var(--wg-faq-img-radius, 24px); }

.waggly-faq__list { display: flex; flex-direction: column; gap: 14px; }
.waggly-faq__item {
  background: var(--wg-faq-row-bg, #FDE4EA);
  border-radius: 16px;
  padding: 4px 22px;
  overflow: hidden;
}
.waggly-faq__q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 18px 0;
  cursor: pointer;
  list-style: none;
  font-family: var(--font-heading-family);
  font-weight: 600;
  font-size: 1.02rem;
  color: var(--color-base);
}
.waggly-faq__q::-webkit-details-marker { display: none; }
.waggly-faq__chevron {
  width: 16px;
  height: 16px;
  flex: 0 0 auto;
  color: var(--color-base);
  transition: transform var(--duration-short, .2s) ease;
}
.waggly-faq__item[open] .waggly-faq__chevron { transform: rotate(180deg); }
.waggly-faq__a {
  padding: 0 0 18px;
  color: var(--color-base);
  opacity: .85;
  line-height: 1.5;
}
.waggly-faq__a p { margin: 0 0 10px; }
.waggly-faq__a p:last-child { margin-bottom: 0; }

@media (max-width: 989px) {
  .waggly-faq__inner { grid-template-columns: 1fr; gap: 24px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly FAQ",
  "tag": "section",
  "class": "waggly-faq-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading style",
      "options": [
        { "value": "normal", "label": "Normal (Outfit)" },
        { "value": "handwritten", "label": "Handwritten (Kalam)" }
      ],
      "default": "normal"
    },
    { "type": "checkbox", "id": "show_paw", "label": "Show paw next to heading", "default": true },
    { "type": "richtext", "id": "subtext", "label": "Text under heading (optional)" },
    { "type": "header", "content": "Side image (under the left text)" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "image_width", "label": "Max image width", "info": "0 = fill the column.", "min": 0, "max": 600, "step": 20, "unit": "px", "default": 0 },
    { "type": "range", "id": "image_radius", "label": "Corner radius", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 24 },
    { "type": "color", "id": "row_bg", "label": "Question row background", "default": "#FDE4EA" },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Boxed" },
        { "value": "page-wide", "label": "Full width" }
      ],
      "default": "page-width"
    },
    { "type": "header", "content": "Spacing" },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "normal"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Frequently asked question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Use this text to answer the question in as much detail as possible for your customers.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Waggly FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
