{%- liquid
  assign s = section.settings
  assign shift_img = ''
  if s.image != blank
    assign shift_img = s.image | image_url: width: 1200
  elsif s.image_asset != blank
    assign shift_img = s.image_asset | asset_url
  endif
-%}

<section class="waggly-os-shift top-spacing-{{ s.top_spacing }}{% if shift_img == blank %} waggly-os-shift--no-image{% endif %}" style="--os-doodle: {{ s.doodle_color }};">
  {%- if s.show_doodles -%}
    <div class="waggly-os-shift__doodles" aria-hidden="true">
      <svg class="waggly-os-shift__doodle waggly-os-shift__doodle--1" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z"/></svg>
      <svg class="waggly-os-shift__doodle waggly-os-shift__doodle--2" viewBox="0 0 28 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 8c3-6 6 4 9-1s6-5 9 1"/></svg>
    </div>
  {%- endif -%}
  <div class="waggly-os-shift__wrap waggly-os-shift__split">
    <div class="waggly-os-shift__text">
      {%- if s.eyebrow != blank -%}<span class="waggly-os-shift__kicker">{{ s.eyebrow | escape }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="waggly-os-shift__heading">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.body != blank -%}<div class="waggly-os-shift__body rte">{{ s.body }}</div>{%- endif -%}
      {%- if s.pull != blank -%}<p class="waggly-os-shift__pull">{{ s.pull | escape }}</p>{%- endif -%}
    </div>
    {%- if shift_img != blank -%}
      <div class="waggly-os-shift__photo">
        <img src="{{ shift_img }}" alt="{{ s.image.alt | default: 'Yours Waggly pets' | escape }}" loading="lazy">
      </div>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="waggly-os-shift__wrap">
      <div class="waggly-os-shift__roles" aria-label="{{ s.strip_label | escape }}">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- if forloop.index == s.arrow_after and s.arrow_label != blank -%}
            <div class="waggly-os-shift__arrow" aria-hidden="true">{{ s.arrow_label | escape }}</div>
          {%- endif -%}
          <div class="waggly-os-shift__role{% if b.muted %} is-muted{% endif %}" {{ block.shopify_attributes }}>
            <div class="waggly-os-shift__ic">
              {%- if b.svg_code != blank -%}{{ b.svg_code }}{%- endif -%}
            </div>
            <div>
              {%- if b.title != blank -%}<b>{{ b.title | escape }}</b>{%- endif -%}
              {%- if b.subtitle != blank -%}<small>{{ b.subtitle | escape }}</small>{%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
.waggly-os-shift {
  --os-navy: #0D386F;
  --os-navy2: #4A5D80;
  --os-pink: #E83D74;
  --os-pinkS: #FDE4EA;
  --os-line: #F6D6DE;
  padding: 76px 0;
  color: var(--os-navy);
  position: relative;
  overflow: hidden;
}
.waggly-os-shift__doodles { position: absolute; inset: 0; pointer-events: none; color: var(--os-doodle, #E83D74); }
.waggly-os-shift__doodle { position: absolute; opacity: .6; }
.waggly-os-shift__doodle--1 { width: 22px; height: 22px; top: 12%; right: 7%; transform: rotate(10deg); }
.waggly-os-shift__doodle--2 { width: 32px; height: 16px; top: 22%; right: 2%; opacity: .5; }
.waggly-os-shift__wrap { position: relative; max-width: 1120px; margin: 0 auto; padding: 0 20px; }
.waggly-os-shift__split {
  display: grid;
  grid-template-columns: 1.15fr .85fr;
  gap: 56px;
  align-items: center;
}
.waggly-os-shift--no-image .waggly-os-shift__split { grid-template-columns: 1fr; }
.waggly-os-shift__kicker {
  display: inline-block;
  font-family: var(--font-body-family);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--os-pink);
  margin-bottom: 12px;
}
.waggly-os-shift__heading {
  font-family: var(--font-heading-family);
  font-weight: 800;
  line-height: 1.15;
  color: var(--os-navy);
  font-size: clamp(28px, 3.6vw, 40px);
  margin: 0 0 18px;
}
.waggly-os-shift__body { color: var(--os-navy2); line-height: 1.65; }
.waggly-os-shift__body p { margin: 0 0 16px; }
.waggly-os-shift__body p:last-child { margin-bottom: 0; }
.waggly-os-shift__pull {
  border-left: 4px solid var(--os-pink);
  padding: 6px 0 6px 20px;
  margin: 22px 0 0;
  font-size: 21px;
  font-weight: 600;
  color: var(--os-navy);
  line-height: 1.4;
}
.waggly-os-shift__photo {
  position: relative;
  display: flex;
  justify-content: center;
}
.waggly-os-shift__photo::before {
  content: "";
  position: absolute;
  inset: 4%;
  background: radial-gradient(58% 58% at 50% 48%, rgba(249, 203, 217, .8), rgba(249, 203, 217, 0) 70%);
  z-index: 0;
}
.waggly-os-shift__photo img {
  position: relative;
  z-index: 1;
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
  filter: drop-shadow(0 16px 28px rgba(13, 56, 111, .14));
}

.waggly-os-shift__roles {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 40px;
}
.waggly-os-shift__role {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14px;
  background: #fff;
  border: 1px solid var(--os-line);
  border-radius: 18px;
  padding: 16px 18px;
}
.waggly-os-shift__role.is-muted { opacity: .6; }
.waggly-os-shift__ic {
  flex: 0 0 46px;
  height: 46px;
  border-radius: 50%;
  background: var(--os-pinkS);
  display: flex;
  align-items: center;
  justify-content: center;
}
.waggly-os-shift__role.is-muted .waggly-os-shift__ic { background: #EEF1F6; }
.waggly-os-shift__ic svg { width: 22px; height: 22px; }
.waggly-os-shift__role b { display: block; font-size: 16.5px; color: var(--os-navy); }
.waggly-os-shift__role small { color: var(--os-navy2); font-size: 14.5px; }
.waggly-os-shift__arrow {
  flex: 0 0 auto;
  text-align: center;
  color: var(--os-pink);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
}

@media (max-width: 900px) {
  .waggly-os-shift { padding: 56px 0; }
  .waggly-os-shift__split { grid-template-columns: 1fr; gap: 32px; }
  .waggly-os-shift__photo { max-width: 420px; margin: 0 auto; }
  .waggly-os-shift__roles { flex-direction: column; align-items: stretch; }
  .waggly-os-shift__arrow { transform: rotate(90deg); }
  .waggly-os-shift__doodles { display: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly OS shift",
  "tag": "section",
  "class": "waggly-os-shift-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What we noticed" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pets are becoming part of our lives in a much deeper way" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Pets are no longer being brought home only for companionship or security, or looked at as simply another species. Increasingly, they are becoming a part of our lives in a much deeper way: a source of happiness, comfort, companionship and emotional well-being.</p><p>At a time when stress has become a part of everyday life across ages and generations, the simple presence of a pet can bring a smile, lift our mood and add a sense of joy to our day.</p>" },
    { "type": "text", "id": "pull", "label": "Pull quote", "default": "Having them around has, in many ways, become a little dose of happiness we look forward to." },
    { "type": "image_picker", "id": "image", "label": "Side photo (optional)" },
    { "type": "text", "id": "image_asset", "label": "or theme-asset filename", "info": "Fallback when no image is picked, e.g. os-shift-pets.png." },
    { "type": "header", "content": "Then → Now strip" },
    { "type": "text", "id": "strip_label", "label": "Strip accessible label", "default": "How the role of pets is changing" },
    { "type": "text", "id": "arrow_label", "label": "Arrow label", "default": "Now →" },
    { "type": "range", "id": "arrow_after", "label": "Insert arrow before block #", "min": 0, "max": 6, "step": 1, "default": 2, "info": "e.g. 2 places the arrow between the 1st and 2nd role. 0 hides it." },
    { "type": "header", "content": "Decoration" },
    { "type": "checkbox", "id": "show_doodles", "label": "Show hand-drawn doodles", "default": true },
    { "type": "color", "id": "doodle_color", "label": "Doodle colour", "default": "#E83D74" },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Gap above section",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    {
      "type": "role",
      "name": "Role",
      "settings": [
        { "type": "checkbox", "id": "muted", "label": "Muted (“Then” style)", "default": false },
        { "type": "text", "id": "title", "label": "Title", "default": "Happiness" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "A smile at the end of the day" },
        { "type": "html", "id": "svg_code", "label": "Icon SVG" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Waggly OS shift",
      "blocks": [
        { "type": "role", "settings": { "muted": true, "title": "Then", "subtitle": "Companionship and security", "svg_code": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4A5D80\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 11l9-7 9 7v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z\"/></svg>" } },
        { "type": "role", "settings": { "muted": false, "title": "Happiness", "subtitle": "A smile at the end of the day", "svg_code": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#E83D74\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01\"/></svg>" } },
        { "type": "role", "settings": { "muted": false, "title": "Comfort & companionship", "subtitle": "Someone who is always there", "svg_code": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#E83D74\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z\"/></svg>" } },
        { "type": "role", "settings": { "muted": false, "title": "Emotional well-being", "subtitle": "A lighter mood, a calmer mind", "svg_code": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#E83D74\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3c4 3 6 6 6 9a6 6 0 0 1-12 0c0-3 2-6 6-9z\"/><path d=\"M12 12v5\"/></svg>" } }
      ]
    }
  ]
}
{% endschema %}
