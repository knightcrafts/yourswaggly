{%- liquid
  assign s = section.settings
-%}

<section class="waggly-value top-spacing-{{ s.top_spacing }}">
  <div class="{% if s.width == 'page-width' %}page-width{% else %}page-wide{% endif %}">
    <div class="waggly-value__card" style="--wg-value-bg: {{ s.bg_color }}; --wg-icon-bg: {{ s.icon_bg }};">
      <div class="waggly-value__body">
        {%- if s.heading != blank -%}
          <h2 class="waggly-value__heading">{{ s.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="waggly-value__list" role="list">
            {%- for block in section.blocks -%}
              <li class="waggly-value__item" {{ block.shopify_attributes }}>
                <span class="waggly-value__icon" aria-hidden="true">
                  {%- if block.settings.icon != blank -%}
                    {%- assign icon = block.settings.icon -%}
                    <img src="{{ icon | image_url: width: 96 }}" width="48" height="48" alt="" loading="lazy">
                  {%- else -%}
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" aria-hidden="true" focusable="false">
                      <path d="M12 3.5l2.6 5.27 5.82.85-4.21 4.1.99 5.79L12 16.77l-5.2 2.73.99-5.79-4.21-4.1 5.82-.85L12 3.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                    </svg>
                  {%- endif -%}
                </span>
                {%- if block.settings.label != blank -%}
                  <span class="waggly-value__label">{{ block.settings.label | escape }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="waggly-value__media">
        {%- if s.image != blank -%}
          {%- assign img = s.image -%}
          <img
            class="waggly-value__image"
            src="{{ img | image_url: width: 600 }}"
            srcset="{{ img | image_url: width: 300 }} 300w, {{ img | image_url: width: 600 }} 600w"
            sizes="(min-width: 990px) 280px, 60vw"
            width="{{ img.width }}"
            height="{{ img.height }}"
            alt="{{ img.alt | escape }}"
            loading="lazy"
          >
        {%- else -%}
          <div class="waggly-value__image waggly-value__image--placeholder">
            {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.waggly-value__card {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 30px;
  background: var(--wg-value-bg, #EFE6DE);
  border-radius: 32px;
  padding: 40px;
}
.waggly-value__heading {
  font-family: 'Kalam', cursive;
  font-weight: 700;
  font-size: clamp(2rem, 3.4vw, 2.8rem);
  color: var(--color-base);
  margin: 0 0 28px;
  display: inline-block;
  border-bottom: 3px solid var(--color-base);
  padding-bottom: 4px;
}
.waggly-value__list {
  display: flex;
  flex-wrap: wrap;
  gap: 26px 30px;
  margin: 0;
  padding: 0;
}
.waggly-value__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 12px;
  width: 130px;
}
.waggly-value__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: var(--wg-icon-bg, #FFFFFF);
  color: var(--color-base);
}
.waggly-value__icon img { width: 30px; height: 30px; object-fit: contain; }
.waggly-value__label { font-size: .95rem; line-height: 1.3; color: var(--color-base); }
.waggly-value__media { display: flex; justify-content: center; }
.waggly-value__image { max-width: 100%; height: auto; display: block; }
.waggly-value__image--placeholder { width: 260px; border-radius: 20px; overflow: hidden; }
.waggly-value__image--placeholder .placeholder-svg { width: 100%; height: auto; display: block; opacity: .5; }

@media (max-width: 989px) {
  .waggly-value__card { grid-template-columns: 1fr; text-align: center; }
  .waggly-value__heading { display: inline-block; }
  .waggly-value__list { justify-content: center; }
  .waggly-value__media { order: -1; }
  .waggly-value__image--placeholder { width: 200px; }
}
@media (max-width: 576px) {
  .waggly-value__card { padding: 28px 20px; border-radius: 24px; }
  .waggly-value__list { gap: 22px 18px; }
  .waggly-value__item { width: calc(50% - 9px); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly value",
  "tag": "section",
  "class": "waggly-value-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Because They Deserve The Best" },
    { "type": "image_picker", "id": "image", "label": "Illustration" },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "page-wide", "label": "Full width" },
        { "value": "page-width", "label": "Boxed" }
      ],
      "default": "page-wide"
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Card background", "default": "#f2ebe3" },
    { "type": "color", "id": "icon_bg", "label": "Icon background", "default": "#FFFFFF" },
    { "type": "header", "content": "Spacing" },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "normal"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value point",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon (optional)", "info": "Leave empty to use the default star icon." },
        { "type": "text", "id": "label", "label": "Label", "default": "Premium Quality Products" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Waggly value",
      "blocks": [
        { "type": "value", "settings": { "label": "Premium Quality Products" } },
        { "type": "value", "settings": { "label": "Vet Approved & Safe" } },
        { "type": "value", "settings": { "label": "Free Shipping above $49" } },
        { "type": "value", "settings": { "label": "7 Day Easy Returns" } },
        { "type": "value", "settings": { "label": "24/7 Pet Care Support" } }
      ]
    }
  ]
}
{% endschema %}
