{%- liquid
  assign s = section.settings
  assign item_style = s.item_style | default: 'compact'
  assign image_position = s.image_position | default: 'right'
  # Default to the handwritten (Kalam) heading unless explicitly set to normal — preserves existing usage.
  assign heading_hand = true
  if s.heading_style == 'normal'
    assign heading_hand = false
  endif
-%}

<section class="waggly-value waggly-value--{{ item_style }} waggly-value--img-{{ image_position }}{% if heading_hand %} waggly-value--hand{% endif %}{% if s.bg_color == blank or s.bg_color == 'rgba(0,0,0,0)' %} waggly-value--plain{% endif %} top-spacing-{{ s.top_spacing }}">
  <div class="{% if s.width == 'page-width' %}page-width{% else %}page-wide{% endif %}">
    <div class="waggly-value__card" style="--wg-value-bg: {{ s.bg_color }}; --wg-icon-bg: {{ s.icon_bg }};{% if s.image_width > 0 %} --wg-value-img-w: {{ s.image_width }}px;{% endif %}">
      <div class="waggly-value__body">
        {%- if s.eyebrow != blank -%}
          <p class="waggly-value__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if s.heading != blank -%}
          <h2 class="waggly-value__heading">{{ s.heading | escape }}</h2>
        {%- endif -%}

        {%- if s.intro != blank -%}
          <div class="waggly-value__intro rte">{{ s.intro }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="waggly-value__list" role="list">
            {%- for block in section.blocks -%}
              {%- assign b = block.settings -%}
              <li class="waggly-value__item" {{ block.shopify_attributes }}>
                <span class="waggly-value__icon" aria-hidden="true">
                  {%- if b.svg_code != blank -%}{{ b.svg_code }}
                  {%- elsif b.icon != blank -%}
                    {%- assign icon = b.icon -%}
                    <img src="{{ icon | image_url: width: 96 }}" width="48" height="48" alt="" loading="lazy">
                  {%- else -%}
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" aria-hidden="true" focusable="false">
                      <path d="M12 3.5l2.6 5.27 5.82.85-4.21 4.1.99 5.79L12 16.77l-5.2 2.73.99-5.79-4.21-4.1 5.82-.85L12 3.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                    </svg>
                  {%- endif -%}
                </span>
                {%- if b.label != blank or b.sublabel != blank -%}
                  <div class="waggly-value__item-body">
                    {%- if b.label != blank -%}<span class="waggly-value__label">{{ b.label | escape }}</span>{%- endif -%}
                    {%- if b.sublabel != blank -%}<span class="waggly-value__sublabel">{{ b.sublabel | escape }}</span>{%- endif -%}
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="waggly-value__media">
        {%- if s.image != blank -%}
          {%- assign img = s.image -%}
          <img
            class="waggly-value__image"
            src="{{ img | image_url: width: 600 }}"
            srcset="{{ img | image_url: width: 300 }} 300w, {{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 900 }} 900w"
            sizes="(min-width: 990px) 40vw, 60vw"
            width="{{ img.width }}"
            height="{{ img.height }}"
            alt="{{ img.alt | escape }}"
            loading="lazy"
          >
        {%- else -%}
          <div class="waggly-value__image waggly-value__image--placeholder">
            {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.waggly-value__card {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 30px;
  background: var(--wg-value-bg, #FDE4EA);
  border-radius: 32px;
  padding: 40px;
}
.waggly-value--plain .waggly-value__card { background: transparent; padding: 0; border-radius: 0; }
.waggly-value--img-left .waggly-value__media { order: -1; }
.waggly-value--img-left.waggly-value--detailed .waggly-value__card { grid-template-columns: minmax(0, 42%) 1fr; }

.waggly-value__eyebrow {
  font-family: var(--font-body-family);
  font-weight: 600;
  font-size: .85rem;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin: 0 0 10px;
}
.waggly-value__heading {
  font-family: var(--font-heading-family);
  font-weight: 700;
  font-size: clamp(1.8rem, 3.4vw, 2.6rem);
  color: var(--color-base);
  margin: 0 0 16px;
}
.waggly-value--hand .waggly-value__heading {
  font-family: 'Kalam', cursive;
  display: inline-block;
  border-bottom: 3px solid var(--color-base);
  padding-bottom: 4px;
  margin-bottom: 28px;
}
.waggly-value__intro {
  max-width: 54ch;
  color: var(--color-base);
  opacity: .85;
  margin: 0 0 26px;
}
.waggly-value__intro p { margin: 0 0 10px; }
.waggly-value__intro p:last-child { margin-bottom: 0; }

.waggly-value__list {
  display: flex;
  flex-wrap: wrap;
  gap: 26px 30px;
  margin: 0;
  padding: 0;
  list-style: none;
}
.waggly-value__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: var(--wg-icon-bg, #FFFFFF);
  color: var(--color-base);
}
.waggly-value__icon img { width: 30px; height: 30px; object-fit: contain; }
.waggly-value__icon svg { width: 28px; height: 28px; }
.waggly-value__label { font-size: .95rem; line-height: 1.3; color: var(--color-base); }
.waggly-value__sublabel { font-size: .85rem; line-height: 1.3; color: var(--color-base); opacity: .7; }

/* Compact (icon on top, centered) — homepage "Because They Deserve The Best" */
.waggly-value--compact .waggly-value__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 12px;
  width: 130px;
}

/* Detailed (icon beside title + subtitle, 2-col grid) — "Why Choose" */
.waggly-value--detailed .waggly-value__list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24px 28px;
}
.waggly-value--detailed .waggly-value__item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  text-align: left;
}
.waggly-value--detailed .waggly-value__item-body { display: flex; flex-direction: column; gap: 2px; }
.waggly-value--detailed .waggly-value__label { font-weight: 700; font-size: 1rem; }

.waggly-value__media { display: flex; justify-content: center; }
.waggly-value__image { max-width: var(--wg-value-img-w, 100%); height: auto; display: block; }
.waggly-value--detailed .waggly-value__image { max-width: var(--wg-value-img-w, 460px); width: 100%; }
.waggly-value__image--placeholder { width: var(--wg-value-img-w, 260px); border-radius: 20px; overflow: hidden; }
.waggly-value__image--placeholder .placeholder-svg { width: 100%; height: auto; display: block; opacity: .5; }

@media (max-width: 989px) {
  .waggly-value__card,
  .waggly-value--img-left.waggly-value--detailed .waggly-value__card { grid-template-columns: 1fr; text-align: center; }
  .waggly-value__heading { display: inline-block; }
  .waggly-value__intro { margin-inline: auto; }
  .waggly-value__list { justify-content: center; }
  .waggly-value__media { order: -1; }
  .waggly-value--detailed .waggly-value__item { text-align: left; }
  .waggly-value__image--placeholder { width: 200px; }
}
@media (max-width: 576px) {
  .waggly-value--plain .waggly-value__card { padding: 0; }
  .waggly-value__card { padding: 28px 20px; border-radius: 24px; }
  .waggly-value__list { gap: 22px 18px; }
  .waggly-value--compact .waggly-value__item { width: calc(50% - 9px); }
  .waggly-value--detailed .waggly-value__list { grid-template-columns: 1fr; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly value",
  "tag": "section",
  "class": "waggly-value-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Because They Deserve The Best" },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading style",
      "options": [
        { "value": "kalam", "label": "Handwritten (Kalam, underlined)" },
        { "value": "normal", "label": "Normal (Outfit)" }
      ],
      "default": "kalam"
    },
    { "type": "richtext", "id": "intro", "label": "Intro text (optional)" },
    { "type": "image_picker", "id": "image", "label": "Illustration" },
    { "type": "range", "id": "image_width", "label": "Image width (desktop)", "info": "Set to 0 for automatic size.", "min": 0, "max": 680, "step": 20, "unit": "px", "default": 0 },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "item_style",
      "label": "Item style",
      "info": "Compact = icon on top, centered. Detailed = icon beside title + subtitle in a 2-column grid.",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "detailed", "label": "Detailed" }
      ],
      "default": "compact"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "page-wide", "label": "Full width" },
        { "value": "page-width", "label": "Boxed" }
      ],
      "default": "page-wide"
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Card background", "info": "Leave empty / transparent for no card.", "default": "#FDE4EA" },
    { "type": "color", "id": "icon_bg", "label": "Icon background", "default": "#FFFFFF" },
    { "type": "header", "content": "Spacing" },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "normal"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value point",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon image (optional)", "info": "Leave empty to use the default star icon." },
        { "type": "html", "id": "svg_code", "label": "or inline SVG (optional)" },
        { "type": "text", "id": "label", "label": "Label", "default": "Premium Quality Products" },
        { "type": "text", "id": "sublabel", "label": "Sub-label (optional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Waggly value",
      "blocks": [
        { "type": "value", "settings": { "label": "Premium Quality Products" } },
        { "type": "value", "settings": { "label": "Vet Approved & Safe" } },
        { "type": "value", "settings": { "label": "Free Shipping above $49" } },
        { "type": "value", "settings": { "label": "7 Day Easy Returns" } },
        { "type": "value", "settings": { "label": "24/7 Pet Care Support" } }
      ]
    }
  ]
}
{% endschema %}
