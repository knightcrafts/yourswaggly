{%- liquid
  assign s = section.settings
  assign axis_max = s.axis_max | default: 12
  if axis_max <= 0
    assign axis_max = 12
  endif
  assign axis_step = s.axis_step | default: 2
  if axis_step <= 0
    assign axis_step = 2
  endif
  assign max_months = axis_max | times: 12
  assign tick_count = axis_max | divided_by: axis_step
-%}

<section class="waggly-agebars top-spacing-{{ s.top_spacing }}" style="--wg-agebars-bg: {{ s.bg_color }};">
  <div class="{% if s.width == 'page-wide' %}page-wide{% else %}page-width{% endif %}">
    {%- if s.eyebrow != blank or s.heading != blank or s.intro != blank -%}
      <header class="waggly-agebars__head">
        {%- if s.eyebrow != blank -%}<p class="waggly-agebars__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="waggly-agebars__heading{% if s.heading_style == 'handwritten' %} waggly-agebars__heading--hand{% endif %}">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.intro != blank -%}<div class="waggly-agebars__intro rte">{{ s.intro }}</div>{%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="waggly-agebars__card">
        {%- if s.card_title != blank or s.card_note != blank -%}
          <p class="waggly-agebars__card-title">{{ s.card_title | escape }}{% if s.card_note != blank %} <span>{{ s.card_note | escape }}</span>{% endif %}</p>
        {%- endif -%}

        <div class="waggly-agebars__rows">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            {%- assign start_m = b.start_months | at_least: 0 -%}
            {%- assign end_m = b.end_months | at_least: 0 -%}
            {%- if end_m > max_months -%}{%- assign end_m = max_months -%}{%- endif -%}
            {%- assign span_m = end_m | minus: start_m -%}
            {%- if span_m < 0 -%}{%- assign span_m = 0 -%}{%- endif -%}
            {%- assign left_pct = start_m | times: 100.0 | divided_by: max_months -%}
            {%- assign width_pct = span_m | times: 100.0 | divided_by: max_months -%}
            <div class="waggly-agebars__row" {{ block.shopify_attributes }}>
              <span class="waggly-agebars__label">{{ b.label | escape }}</span>
              <div class="waggly-agebars__track">
                <div class="waggly-agebars__bar" style="left: {{ left_pct }}%; width: {{ width_pct }}%;">
                  <span class="waggly-agebars__bar-text">{{ b.range_text | escape }}</span>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="waggly-agebars__axis" aria-hidden="true">
          <span class="waggly-agebars__axis-spacer"></span>
          <div class="waggly-agebars__ticks">
            {%- for i in (0..tick_count) -%}
              {%- assign tickval = i | times: axis_step -%}
              {%- assign tleft = tickval | times: 100.0 | divided_by: axis_max -%}
              <span style="left: {{ tleft }}%;">{{ tickval }}{% if forloop.last and s.axis_unit != blank %} {{ s.axis_unit }}{% endif %}</span>
            {%- endfor -%}
          </div>
        </div>

        {%- if s.legend != blank -%}
          <p class="waggly-agebars__legend"><i aria-hidden="true"></i><span>{{ s.legend | escape }}</span></p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.waggly-agebars { background: var(--wg-agebars-bg, transparent); }
.waggly-agebars__head { margin-bottom: 30px; }
.waggly-agebars__eyebrow {
  font-family: var(--font-body-family);
  font-weight: 600;
  font-size: .85rem;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin: 0 0 10px;
}
.waggly-agebars__heading {
  font-family: var(--font-heading-family);
  font-weight: 700;
  color: var(--color-base);
  font-size: clamp(1.9rem, 3.6vw, 2.9rem);
  margin: 0 0 14px;
}
.waggly-agebars__heading--hand { font-family: 'Kalam', cursive; }
.waggly-agebars__intro {
  max-width: 64ch;
  color: var(--color-base);
  opacity: .85;
  line-height: 1.55;
}
.waggly-agebars__intro p { margin: 0 0 10px; }
.waggly-agebars__intro p:last-child { margin-bottom: 0; }

.waggly-agebars__card {
  background: #fff;
  border: 1px solid var(--color-lines-borders, #F6D6DE);
  border-radius: 22px;
  padding: 26px 28px 20px;
  box-shadow: 0 12px 30px rgba(13, 56, 111, .05);
}
.waggly-agebars__card-title {
  font-weight: 700;
  color: var(--color-base);
  font-size: 1rem;
  margin: 0 0 20px;
}
.waggly-agebars__card-title span { font-weight: 500; color: var(--color-secondary-text, #4A5D80); }

.waggly-agebars__row {
  display: grid;
  grid-template-columns: 150px 1fr;
  align-items: center;
  gap: 14px;
  margin-bottom: 12px;
}
.waggly-agebars__label {
  font-weight: 700;
  font-size: .92rem;
  color: var(--color-base);
}
.waggly-agebars__track {
  position: relative;
  height: 26px;
  background: #FFF4F5;
  border-radius: 999px;
}
.waggly-agebars__bar {
  position: absolute;
  top: 0;
  height: 100%;
  min-width: 6px;
  border-radius: 999px;
  background: linear-gradient(90deg, #E83D74, #F27BA0);
  display: flex;
  align-items: center;
  padding-left: 10px;
  overflow: hidden;
}
.waggly-agebars__bar-text {
  color: #fff;
  font-size: 12.5px;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

.waggly-agebars__axis {
  display: grid;
  grid-template-columns: 150px 1fr;
  gap: 14px;
  margin-top: 4px;
}
.waggly-agebars__ticks {
  position: relative;
  height: 22px;
  font-size: 12.5px;
  color: var(--color-secondary-text, #4A5D80);
}
.waggly-agebars__ticks span {
  position: absolute;
  transform: translateX(-50%);
  white-space: nowrap;
}

.waggly-agebars__legend {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  margin: 16px 0 0;
  font-size: .9rem;
  color: var(--color-secondary-text, #4A5D80);
}
.waggly-agebars__legend i {
  flex: 0 0 auto;
  display: inline-block;
  width: 14px;
  height: 14px;
  margin-top: 3px;
  border-radius: 4px;
  background: linear-gradient(90deg, #E83D74, #F27BA0);
}

@media (max-width: 749px) {
  .waggly-agebars__card { padding: 22px 18px 18px; }
  .waggly-agebars__row,
  .waggly-agebars__axis { grid-template-columns: 96px 1fr; gap: 10px; }
  .waggly-agebars__label { font-size: .82rem; }
  .waggly-agebars__bar-text { font-size: 10.5px; }
  .waggly-agebars__ticks { font-size: 11px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly age bars",
  "tag": "section",
  "class": "waggly-agebars-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)", "default": "Timing matters" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The window to join closes early" },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading style",
      "options": [
        { "value": "normal", "label": "Normal (Outfit)" },
        { "value": "handwritten", "label": "Handwritten (Kalam)" }
      ],
      "default": "normal"
    },
    { "type": "richtext", "id": "intro", "label": "Intro text (optional)" },
    { "type": "header", "content": "Chart card" },
    { "type": "text", "id": "card_title", "label": "Card title", "default": "When a new dog can join" },
    { "type": "text", "id": "card_note", "label": "Card title note (lighter)", "default": "(small, medium & large breeds)" },
    { "type": "range", "id": "axis_max", "label": "Axis maximum (years)", "min": 4, "max": 24, "step": 1, "default": 12 },
    { "type": "range", "id": "axis_step", "label": "Axis tick step (years)", "min": 1, "max": 6, "step": 1, "default": 2 },
    { "type": "text", "id": "axis_unit", "label": "Axis unit label", "default": "yrs" },
    { "type": "text", "id": "legend", "label": "Legend", "default": "Age at which a new policy can be bought. Once insured, renewing on time keeps your pet covered beyond these ages." },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Boxed" },
        { "value": "page-wide", "label": "Full width" }
      ],
      "default": "page-width"
    },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#FCE1E7" },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "normal"
    }
  ],
  "blocks": [
    {
      "type": "bar",
      "name": "Insurer bar",
      "settings": [
        { "type": "text", "id": "label", "label": "Insurer name", "default": "Insurer" },
        { "type": "text", "id": "range_text", "label": "Range label (shown in bar)", "default": "3 months – 7 years" },
        { "type": "number", "id": "start_months", "label": "Start age (months)", "default": 3 },
        { "type": "number", "id": "end_months", "label": "End age (months)", "default": 84 }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Waggly age bars",
      "blocks": [
        { "type": "bar" },
        { "type": "bar" },
        { "type": "bar" }
      ]
    }
  ]
}
{% endschema %}
