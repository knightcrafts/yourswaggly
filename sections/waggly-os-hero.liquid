{%- liquid
  assign s = section.settings
  assign hero_img = ''
  if s.image != blank
    assign hero_img = s.image | image_url: width: 1400
  elsif s.image_asset != blank
    assign hero_img = s.image_asset | asset_url
  endif
  assign is_split = false
  if s.hero_layout == 'split' and hero_img != blank
    assign is_split = true
  endif
-%}

<div class="waggly-os-hero top-spacing-{{ s.top_spacing }}{% if is_split %} waggly-os-hero--split{% endif %}" style="--os-bg-start: {{ s.bg_start }}; --os-bg-end: {{ s.bg_end }}; --os-pink: {{ s.accent_color }}; --os-doodle: {{ s.doodle_color }};">
  {%- if s.show_paws -%}
    <svg class="waggly-os-hero__paws" viewBox="0 0 1200 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <g fill="#F6C9D5">
        <g transform="translate(110,90) rotate(-20)"><ellipse cy="12" rx="16" ry="13"/><circle cx="-14" cy="-6" r="6.5"/><circle cx="-5" cy="-15" r="6.5"/><circle cx="6" cy="-15" r="6.5"/><circle cx="15" cy="-6" r="6.5"/></g>
        <g transform="translate(190,290) rotate(15) scale(.8)"><ellipse cy="12" rx="16" ry="13"/><circle cx="-14" cy="-6" r="6.5"/><circle cx="-5" cy="-15" r="6.5"/><circle cx="6" cy="-15" r="6.5"/><circle cx="15" cy="-6" r="6.5"/></g>
        <g transform="translate(1060,110) rotate(20)"><ellipse cy="12" rx="16" ry="13"/><circle cx="-14" cy="-6" r="6.5"/><circle cx="-5" cy="-15" r="6.5"/><circle cx="6" cy="-15" r="6.5"/><circle cx="15" cy="-6" r="6.5"/></g>
        <g transform="translate(990,300) rotate(-10) scale(.75)"><ellipse cy="12" rx="16" ry="13"/><circle cx="-14" cy="-6" r="6.5"/><circle cx="-5" cy="-15" r="6.5"/><circle cx="6" cy="-15" r="6.5"/><circle cx="15" cy="-6" r="6.5"/></g>
      </g>
      <path d="M80 210 c-8-11-26-6-24 8 c1 9 16 18 24 25 c8-7 23-16 24-25 c2-14-16-19-24-8z" fill="#F7A9BF"/>
      <path d="M1120 230 c-6-8-20-4-18 6 c1 7 12 14 18 19 c6-5 17-12 18-19 c2-10-12-14-18-6z" fill="#F7A9BF"/>
    </svg>
  {%- endif -%}

  {%- if s.show_doodles -%}
    <div class="waggly-os-hero__doodles" aria-hidden="true">
      <svg class="waggly-os-hero__doodle waggly-os-hero__doodle--1" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z"/></svg>
      <svg class="waggly-os-hero__doodle waggly-os-hero__doodle--2" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8z"/></svg>
      <svg class="waggly-os-hero__doodle waggly-os-hero__doodle--3" viewBox="0 0 28 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 8c3-6 6 4 9-1s6-5 9 1"/></svg>
    </div>
  {%- endif -%}

  <div class="waggly-os-hero__wrap">
    <div class="waggly-os-hero__text">
      {%- if s.eyebrow != blank -%}<span class="waggly-os-hero__kicker">{{ s.eyebrow | escape }}</span>{%- endif -%}
      {%- if s.heading != blank -%}
        <h1 class="waggly-os-hero__title">{{ s.heading | escape }}{% if s.heading_accent != blank %} <em class="waggly-os-hero__pk">{{ s.heading_accent | escape }}</em>{% endif %}</h1>
      {%- endif -%}
      {%- if s.lead != blank -%}<p class="waggly-os-hero__lead">{{ s.lead | escape }}</p>{%- endif -%}
      {%- if s.show_divider -%}
        <div class="waggly-os-hero__divider"><span></span>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z"/></svg>
        <span></span></div>
      {%- endif -%}
    </div>

    {%- if hero_img != blank -%}
      <div class="waggly-os-hero__media">
        <img src="{{ hero_img }}" alt="{{ s.image.alt | default: 'Yours Waggly pets' | escape }}" loading="eager">
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.waggly-os-hero {
  --os-navy: #0D386F;
  --os-navy2: #4A5D80;
  --os-line: #F6D6DE;
  background: linear-gradient(180deg, var(--os-bg-start, #FFF4F5) 0%, var(--os-bg-end, #fff) 100%);
  padding: 96px 0 72px;
  text-align: center;
  position: relative;
  overflow: hidden;
  color: var(--os-navy);
}
.waggly-os-hero__paws {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  opacity: .5;
}
.waggly-os-hero__doodles { position: absolute; inset: 0; pointer-events: none; color: var(--os-doodle, #E83D74); }
.waggly-os-hero__doodle { position: absolute; opacity: .7; }
.waggly-os-hero__doodle--1 { width: 26px; height: 26px; top: 20%; left: 6%; transform: rotate(-12deg); }
.waggly-os-hero__doodle--2 { width: 20px; height: 20px; top: 14%; right: 46%; opacity: .5; }
.waggly-os-hero__doodle--3 { width: 34px; height: 18px; bottom: 26%; left: 10%; opacity: .55; }
.waggly-os-hero__wrap {
  position: relative;
  max-width: 1120px;
  margin: 0 auto;
  padding: 0 20px;
}
.waggly-os-hero__kicker {
  display: inline-block;
  font-family: var(--font-body-family);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--os-pink, #E83D74);
  margin-bottom: 12px;
}
.waggly-os-hero__title {
  font-family: var(--font-heading-family);
  font-weight: 800;
  line-height: 1.15;
  color: var(--os-navy);
  font-size: clamp(42px, 6.4vw, 72px);
  margin: 0 0 18px;
  letter-spacing: -.5px;
}
.waggly-os-hero__pk { font-style: normal; color: var(--os-pink, #E83D74); }
.waggly-os-hero__lead {
  font-size: clamp(19px, 2.2vw, 24px);
  color: var(--os-navy2);
  line-height: 1.65;
  max-width: 620px;
  margin: 0 auto;
}
.waggly-os-hero__divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin: 28px auto 0;
  color: var(--os-pink, #E83D74);
}
.waggly-os-hero__divider span { width: 60px; height: 2px; background: var(--os-line); }

/* Centered layout: framed image below the text */
.waggly-os-hero__media {
  position: relative;
  max-width: 980px;
  aspect-ratio: 21 / 10;
  margin: 40px auto 0;
  border-radius: 28px;
  overflow: hidden;
  box-shadow: 0 18px 40px rgba(13, 56, 111, .12);
}
.waggly-os-hero__media img { display: block; width: 100%; height: 100%; object-fit: cover; }

/* Split layout: text left, cutout photo right (bleeds, no frame) */
.waggly-os-hero--split { text-align: left; padding: 72px 0; }
.waggly-os-hero--split .waggly-os-hero__wrap {
  display: grid;
  grid-template-columns: 1.02fr .98fr;
  gap: 32px;
  align-items: center;
}
.waggly-os-hero--split .waggly-os-hero__lead { margin: 0; }
.waggly-os-hero--split .waggly-os-hero__divider { justify-content: flex-start; margin-left: 0; }
.waggly-os-hero--split .waggly-os-hero__media {
  max-width: none;
  aspect-ratio: auto;
  margin: 0;
  border-radius: 0;
  overflow: visible;
  box-shadow: none;
  position: relative;
}
.waggly-os-hero--split .waggly-os-hero__media::before {
  content: "";
  position: absolute;
  inset: 6% -6% 6% 6%;
  background: radial-gradient(60% 60% at 55% 45%, rgba(249, 203, 217, .75), rgba(249, 203, 217, 0) 70%);
  z-index: 0;
}
.waggly-os-hero--split .waggly-os-hero__media img {
  position: relative;
  z-index: 1;
  width: 100%;
  height: auto;
  object-fit: contain;
  filter: drop-shadow(0 18px 30px rgba(13, 56, 111, .14));
}

@media (max-width: 900px) {
  .waggly-os-hero--split { text-align: center; }
  .waggly-os-hero--split .waggly-os-hero__wrap { grid-template-columns: 1fr; gap: 24px; }
  .waggly-os-hero--split .waggly-os-hero__lead { margin: 0 auto; }
  .waggly-os-hero--split .waggly-os-hero__divider { justify-content: center; }
}
@media (max-width: 520px) {
  .waggly-os-hero { padding: 68px 0 52px; }
  .waggly-os-hero__doodles { display: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly OS hero",
  "tag": "section",
  "class": "waggly-os-hero-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Love Beyond" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (pink)", "default": "the Bowl" },
    { "type": "text", "id": "lead", "label": "Lead line", "default": "Something has been changing around us." },
    { "type": "image_picker", "id": "image", "label": "Hero image (transparent cutout)", "info": "Pets on a transparent background work best." },
    { "type": "text", "id": "image_asset", "label": "or theme-asset filename", "info": "Fallback used when no image is picked, e.g. os-hero-pets.png in assets/." },
    {
      "type": "select",
      "id": "hero_layout",
      "label": "Layout",
      "info": "Split (text left, photo right) needs a hero image; falls back to Centered when empty.",
      "options": [
        { "value": "centered", "label": "Centered (photo below)" },
        { "value": "split", "label": "Split (photo right)" }
      ],
      "default": "split"
    },
    { "type": "header", "content": "Decoration" },
    { "type": "checkbox", "id": "show_paws", "label": "Show paw-print background", "default": true },
    { "type": "checkbox", "id": "show_divider", "label": "Show heart divider", "default": true },
    { "type": "checkbox", "id": "show_doodles", "label": "Show hand-drawn doodles", "default": true },
    { "type": "color", "id": "doodle_color", "label": "Doodle colour", "default": "#E83D74" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_start", "label": "Gradient top", "default": "#FFF4F5" },
    { "type": "color", "id": "bg_end", "label": "Gradient bottom", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent (pink)", "default": "#E83D74" },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Gap above section",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "none"
    }
  ],
  "presets": [{ "name": "Waggly OS hero" }]
}
{% endschema %}
