{{ 'component-product-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign products = s.collection.products
-%}

<section class="waggly-products top-spacing-{{ s.top_spacing }}">
  <div class="{% if s.width == 'page-wide' %}page-wide{% else %}page-width{% endif %}">
    <div class="waggly-products__head waggly-products__head--{{ s.head_align }}">
      <div class="waggly-products__head-text">
        {%- if s.eyebrow != blank -%}
          <p class="waggly-products__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="waggly-products__heading">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.subtext != blank -%}
          <div class="waggly-products__text rte">{{ s.subtext }}</div>
        {%- endif -%}
      </div>
      {%- if s.view_all_label != blank -%}
        <a class="waggly-products__viewall"{% if s.view_all_link != blank %} href="{{ s.view_all_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>
          {{ s.view_all_label | escape }}
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true" focusable="false"><path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="waggly-products__grid">
      {%- if s.collection != blank and products.size > 0 -%}
        {%- for product in products limit: s.product_limit -%}
          {%- render 'product-card',
            product_card_product: product,
            section_id: section.id,
            settings_image_ratio: '1',
            show_price: true,
            show_type: s.show_subtitle,
            show_vendor: false,
            button_type_product: 'only_icon',
            show_button_quickview: false,
            show_badge_on_sale: true,
            show_badge_sold_out: true,
            show_badge_feature: true,
            hide_product_card_swatches: true,
            product_name_size: 'body2'
          -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..s.product_limit) -%}
          {%- render 'product-card-placeholder', settings_image_ratio: '1', placeholder_name: 'product-1' -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.waggly-products__head { text-align: center; margin-bottom: 34px; }
.waggly-products__head--split {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  text-align: left;
}
.waggly-products__head--split .waggly-products__text { margin: 0; }
.waggly-products__viewall {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--color-accent);
  font-weight: 600;
  text-decoration: none;
  white-space: nowrap;
}
.waggly-products__viewall:hover { text-decoration: underline; }
.waggly-products__viewall[aria-disabled="true"] { opacity: .5; pointer-events: none; }
.waggly-products__head--center .waggly-products__viewall { margin-top: 10px; }
@media (max-width: 576px) {
  .waggly-products__head--split { flex-direction: column; align-items: flex-start; }
}
.waggly-products__eyebrow {
  font-family: var(--font-body-family);
  font-weight: 600;
  font-size: .95rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin: 0 0 8px;
}
.waggly-products__heading {
  font-family: var(--font-heading-family);
  font-size: clamp(1.8rem, 3.5vw, 2.8rem);
  color: var(--color-base);
  margin: 0 0 12px;
}
.waggly-products__text {
  max-width: 60ch;
  margin: 0 auto;
  color: var(--color-base);
  opacity: .8;
}

.waggly-products__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 22px;
}

.waggly-products .product-card {
  background: #ffffff;
  border-radius: 22px;
  padding: 12px;
  box-shadow: 0 10px 30px rgba(22, 19, 69, .06);
  height: 100%;
}
.waggly-products .product-card__image-holder { margin-bottom: 12px; }
.waggly-products .product-card__heading { font-family: var(--font-heading-family); }
.waggly-products .product-card__container > div:has(.product-card__heading) { order: 1; }
.waggly-products .product-card__container > div:has(.product-card__meta) { order: 2; margin-top: 2px; opacity: .7; }
.waggly-products .product-card .price { order: 3; margin-top: 8px; }

/* Add to Cart / Buy Now CTAs are provided by the shared product-card component. */

@media (max-width: 989px) {
  .waggly-products__grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 576px) {
  .waggly-products__grid {
    grid-auto-flow: column;
    grid-auto-columns: 72%;
    grid-template-columns: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 8px;
  }
  .waggly-products .product-card { scroll-snap-align: start; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly products",
  "tag": "section",
  "class": "waggly-products-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our picks" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved By Pets & Chosen By Parents" },
    { "type": "richtext", "id": "subtext", "label": "Text", "default": "<p>Handpicked favorites for healthy, happy pets — quality you can trust.</p>" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_subtitle", "label": "Show product type as subtitle", "default": true },
    {
      "type": "select",
      "id": "head_align",
      "label": "Header alignment",
      "options": [
        { "value": "center", "label": "Centered" },
        { "value": "split", "label": "Left, with View all on the right" }
      ],
      "default": "center"
    },
    { "type": "text", "id": "view_all_label", "label": "View all label (optional)" },
    { "type": "url", "id": "view_all_link", "label": "View all link" },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "page-wide", "label": "Full width" },
        { "value": "page-width", "label": "Boxed" }
      ],
      "default": "page-wide"
    },
    { "type": "header", "content": "Spacing" },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "normal"
    }
  ],
  "presets": [
    { "name": "Waggly products" }
  ]
}
{% endschema %}
