{%- liquid
  assign s = section.settings
  assign heading_tag = s.heading_tag | default: 'h2'
-%}

<section
  class="waggly-hero{% if s.image_position == 'left' %} waggly-hero--reverse{% endif %}{% if s.heading_style == 'handwritten' %} waggly-hero--hand{% endif %} top-spacing-{{ s.top_spacing }}"
  style="--wg-hero-bg: {{ s.bg_color }}; --wg-hero-accent: {{ s.accent_color }};"
>
  <div class="{% if s.width == 'page-wide' %}page-wide{% else %}page-width{% endif %} waggly-hero__inner">
    <div class="waggly-hero__content">
      {%- if s.eyebrow != blank -%}
        <p class="waggly-hero__eyebrow">{{ s.eyebrow | escape }}{%- if s.eyebrow_paw -%}<span class="waggly-hero__paw" aria-hidden="true">🐾</span>{%- endif -%}</p>
      {%- endif -%}

      {%- if s.heading != blank or s.heading_accent != blank -%}
        <{{ heading_tag }} class="waggly-hero__heading">
          {%- if s.heading != blank -%}<span class="waggly-hero__heading-main">{{ s.heading | escape }}</span>{%- endif -%}
          {%- if s.heading_accent != blank -%}<span class="waggly-hero__heading-accent">{{ s.heading_accent | escape }}</span>{%- endif -%}
        </{{ heading_tag }}>
      {%- endif -%}

      {%- if s.subtext != blank -%}
        <div class="waggly-hero__text rte">{{ s.subtext }}</div>
      {%- endif -%}

      {%- if s.primary_label != blank or s.secondary_label != blank -%}
        <div class="waggly-hero__actions">
          {%- if s.primary_label != blank -%}
            <a class="waggly-btn waggly-btn--primary"{% if s.primary_link != blank %} href="{{ s.primary_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>
              {{ s.primary_label | escape }}
            </a>
          {%- endif -%}
          {%- if s.secondary_label != blank -%}
            <a class="waggly-btn waggly-btn--ghost"{% if s.secondary_link != blank %} href="{{ s.secondary_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>
              <span class="waggly-btn__paw" aria-hidden="true">🐾</span>{{ s.secondary_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="waggly-hero__media">
      {%- if s.image != blank -%}
        {%- assign img = s.image -%}
        <img
          class="waggly-hero__image"
          src="{{ img | image_url: width: 900 }}"
          srcset="{{ img | image_url: width: 450 }} 450w, {{ img | image_url: width: 700 }} 700w, {{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1200 }} 1200w"
          sizes="(min-width: 990px) 46vw, 90vw"
          width="{{ img.width }}"
          height="{{ img.height }}"
          alt="{{ img.alt | escape }}"
          loading="lazy"
        >
      {%- else -%}
        <div class="waggly-hero__image waggly-hero__image--placeholder">
          {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}

      {%- if s.show_decoration -%}
        <svg class="waggly-hero__deco waggly-hero__deco--bone" viewBox="0 0 64 32" fill="none" aria-hidden="true" focusable="false">
          <path d="M12 6a6 6 0 1 0-5 10 6 6 0 1 0 5 10l40-20a6 6 0 1 0 5-10 6 6 0 1 0-5-10L12 6Z" fill="currentColor"/>
        </svg>
        <svg class="waggly-hero__deco waggly-hero__deco--paw" viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false">
          <ellipse cx="24" cy="34" rx="12" ry="9" fill="currentColor"/>
          <circle cx="10" cy="20" r="5" fill="currentColor"/>
          <circle cx="20" cy="12" r="5" fill="currentColor"/>
          <circle cx="32" cy="12" r="5" fill="currentColor"/>
          <circle cx="40" cy="20" r="5" fill="currentColor"/>
        </svg>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.waggly-hero {
  background: var(--wg-hero-bg, var(--color-background));
  overflow: hidden;
}
.waggly-hero__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 40px;
  padding-top: 40px;
  padding-bottom: 40px;
}
.waggly-hero--reverse .waggly-hero__content { order: 2; }
.waggly-hero--reverse .waggly-hero__media { order: 1; }

.waggly-hero__eyebrow {
  font-family: var(--font-body-family);
  font-weight: 600;
  font-size: .95rem;
  line-height: 1;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--color-base);
  opacity: .75;
  margin: 0 0 14px;
}
.waggly-hero__paw { margin-inline-start: 6px; }
.waggly-hero--hand .waggly-hero__heading { font-family: 'Kalam', cursive; line-height: 1.1; }
.waggly-hero__heading {
  font-family: var(--font-heading-family);
  font-weight: 700;
  line-height: 1.02;
  margin: 0 0 18px;
  font-size: clamp(2.4rem, 5.2vw, 4.4rem);
}
.waggly-hero__heading-main { display: block; color: var(--color-base); }
.waggly-hero__heading-accent { display: block; color: var(--wg-hero-accent, var(--color-accent)); }
.waggly-hero__text {
  max-width: 44ch;
  font-size: 1.05rem;
  color: var(--color-base);
  opacity: .85;
  margin-bottom: 28px;
}
.waggly-hero--reverse .waggly-hero__text { margin-inline: auto; }

.waggly-hero__actions { display: flex; flex-wrap: wrap; gap: 14px; }
.waggly-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 50px;
  padding: 0 26px;
  border-radius: 999px;
  font-weight: 600;
  text-decoration: none;
  transition: transform var(--duration-short, .2s) ease, background var(--duration-short, .2s) ease;
  cursor: pointer;
}
.waggly-btn:hover { transform: translateY(-2px); }
.waggly-btn--primary { background: var(--color-accent); color: #fff; }
.waggly-btn--ghost {
  background: transparent;
  color: var(--color-accent);
  border: 2px solid var(--color-accent);
}
.waggly-btn--ghost:hover { background: var(--color-accent); color: #fff; }
.waggly-btn[aria-disabled="true"] { opacity: .5; pointer-events: none; }

.waggly-hero__media { position: relative; display: flex; justify-content: center; align-items: center; }
.waggly-hero__image {
  position: relative;
  z-index: 1;
  max-width: 100%;
  height: auto;
  display: block;
}
.waggly-hero__image--placeholder { width: 100%; border-radius: 24px; overflow: hidden; }
.waggly-hero__image--placeholder .placeholder-svg { width: 100%; height: auto; display: block; background: rgba(0,0,0,.05); }

.waggly-hero__deco { position: absolute; z-index: 2; color: var(--wg-hero-accent, var(--color-accent)); opacity: .5; }
.waggly-hero__deco--bone { width: 74px; top: 8%; right: 6%; }
.waggly-hero__deco--paw { width: 42px; bottom: 12%; left: 4%; }

@media (max-width: 989px) {
  .waggly-hero__inner {
    grid-template-columns: 1fr;
    text-align: center;
    gap: 24px;
  }
  .waggly-hero--reverse .waggly-hero__content,
  .waggly-hero--reverse .waggly-hero__media { order: initial; }
  .waggly-hero__content { order: 1; }
  .waggly-hero__media { order: 2; }
  .waggly-hero__text { margin-inline: auto; }
  .waggly-hero__actions { justify-content: center; }
  .waggly-hero__media { max-width: 520px; margin-inline: auto; }
}
@media (max-width: 576px) {
  .waggly-btn { flex: 1 1 auto; justify-content: center; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly hero",
  "tag": "section",
  "class": "waggly-hero-section",
  "settings": [
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left (reversed)" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "page-wide", "label": "Full width" },
        { "value": "page-width", "label": "Boxed" }
      ],
      "default": "page-wide"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag (SEO)",
      "info": "Use H1 for the main hero, H2 for the secondary block.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading style",
      "options": [
        { "value": "normal", "label": "Normal (Outfit)" },
        { "value": "handwritten", "label": "Handwritten (Kalam)" }
      ],
      "default": "normal"
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Happy pets, happy hearts" },
    { "type": "checkbox", "id": "eyebrow_paw", "label": "Show paw next to eyebrow", "default": true },
    { "type": "text", "id": "heading", "label": "Heading line 1", "default": "Everything For" },
    { "type": "text", "id": "heading_accent", "label": "Heading line 2 (accent)", "default": "Cats & Dogs" },
    { "type": "richtext", "id": "subtext", "label": "Text", "default": "<p>Premium care, nutritious food, and cozy essentials for your furry family.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop Now" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Explore Services" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Hero illustration" },
    { "type": "checkbox", "id": "show_decoration", "label": "Show paw & bone decorations", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#f7f2ef" },
    { "type": "color", "id": "accent_color", "label": "Accent (heading line 2)", "default": "#9b643d" },
    { "type": "header", "content": "Spacing" },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "none"
    }
  ],
  "presets": [
    { "name": "Waggly hero" }
  ]
}
{% endschema %}
