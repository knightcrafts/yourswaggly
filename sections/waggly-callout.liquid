{%- liquid
  assign s = section.settings
  assign heading_tag = s.heading_tag | default: 'h2'
-%}

<section class="waggly-callout waggly-callout--icon-{{ s.icon_position }} top-spacing-{{ s.top_spacing }}">
  <div class="{% if s.width == 'page-wide' %}page-wide{% else %}page-width{% endif %}">
    <div class="waggly-callout__box" style="--wg-co-bg: {{ s.bg_color }}; --wg-co-text: {{ s.text_color }}; --wg-co-radius: {{ s.radius | default: 28 }}px; --wg-co-pad: {{ s.vertical_padding | default: 44 }}px; --wg-co-icon: {{ s.icon_size | default: 120 }}px;">
      {%- if s.svg_code != blank or s.icon != blank -%}
        <div class="waggly-callout__icon" aria-hidden="true">
          {%- if s.svg_code != blank -%}
            {{ s.svg_code }}
          {%- else -%}
            {%- assign icon = s.icon -%}
            <img src="{{ icon | image_url: width: 260 }}" width="{{ icon.width }}" height="{{ icon.height }}" alt="" loading="lazy">
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="waggly-callout__content">
        {%- if s.eyebrow != blank -%}<p class="waggly-callout__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<{{ heading_tag }} class="waggly-callout__heading">{{ s.heading | escape }}</{{ heading_tag }}>{%- endif -%}
        {%- if s.body != blank -%}<div class="waggly-callout__body rte">{{ s.body }}</div>{%- endif -%}
        {%- if s.button_label != blank -%}
          <a class="waggly-callout__btn"{% if s.button_link != blank %} href="{{ s.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>{{ s.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.waggly-callout__box {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 30px;
  align-items: center;
  background: var(--wg-co-bg, #0D386F);
  color: var(--wg-co-text, #ffffff);
  border-radius: var(--wg-co-radius, 28px);
  padding: var(--wg-co-pad, 44px);
}
.waggly-callout--icon-right .waggly-callout__box { grid-template-columns: 1fr auto; }
.waggly-callout--icon-right .waggly-callout__icon { order: 2; }
.waggly-callout__icon { width: var(--wg-co-icon, 120px); flex: none; }
.waggly-callout__icon svg,
.waggly-callout__icon img { width: 100%; height: auto; display: block; }
.waggly-callout__eyebrow {
  font-family: var(--font-body-family);
  font-weight: 600;
  font-size: .85rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  opacity: .85;
  margin: 0 0 10px;
}
.waggly-callout__heading {
  font-family: var(--font-heading-family);
  font-weight: 700;
  color: inherit;
  font-size: clamp(1.6rem, 3vw, 2.3rem);
  margin: 0 0 12px;
}
.waggly-callout__body { color: inherit; opacity: .88; max-width: 68ch; }
.waggly-callout__body p { margin: 0 0 1em; }
.waggly-callout__body p:last-child { margin-bottom: 0; }
.waggly-callout__btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 50px;
  padding: 0 28px;
  margin-top: 22px;
  border-radius: 999px;
  background: var(--color-accent);
  color: #fff;
  font-weight: 600;
  text-decoration: none;
  transition: transform var(--duration-short, .2s) ease;
}
.waggly-callout__btn:hover { transform: translateY(-2px); }
.waggly-callout__btn[aria-disabled="true"] { opacity: .5; pointer-events: none; }

@media (max-width: 749px) {
  .waggly-callout__box,
  .waggly-callout--icon-right .waggly-callout__box { grid-template-columns: 1fr; text-align: center; padding: 30px; gap: 20px; }
  .waggly-callout--icon-right .waggly-callout__icon { order: 0; }
  .waggly-callout__icon { margin-inline: auto; width: min(var(--wg-co-icon, 120px), 110px); }
  .waggly-callout__body { margin-inline: auto; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly callout",
  "tag": "section",
  "class": "waggly-callout-section",
  "settings": [
    { "type": "header", "content": "Icon" },
    { "type": "textarea", "id": "svg_code", "label": "Icon SVG code", "info": "Pasted SVG. Takes priority over the image below.", "default": "<svg viewBox='0 0 120 120' aria-hidden='true'><circle cx='60' cy='60' r='58' fill='#FCE1E7'/><path d='M38 30v20a14 14 0 0 0 28 0V30' fill='none' stroke='#0D386F' stroke-width='6' stroke-linecap='round'/><path d='M52 64v8a16 16 0 0 0 32 0v-8' fill='none' stroke='#0D386F' stroke-width='6' stroke-linecap='round'/><circle cx='84' cy='58' r='8' fill='#E83D74'/></svg>" },
    { "type": "image_picker", "id": "icon", "label": "Icon image (optional)" },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 60, "max": 180, "step": 4, "unit": "px", "default": 120 },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk to your vet first" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    { "type": "richtext", "id": "body", "label": "Text", "default": "<p>Share a short, helpful message here.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label (optional)" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Box background", "default": "#0D386F" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "vertical_padding", "label": "Inside padding", "info": "Space inside the box.", "min": 16, "max": 80, "step": 4, "unit": "px", "default": 44 },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Boxed" },
        { "value": "page-wide", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Gap above section",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "normal"
    }
  ],
  "presets": [
    { "name": "Waggly callout" }
  ]
}
{% endschema %}
