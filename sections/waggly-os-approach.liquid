{%- liquid
  assign s = section.settings
-%}

<section class="waggly-os-approach top-spacing-{{ s.top_spacing }}" style="--os-bg: {{ s.bg_color }}; --os-accent: {{ s.accent_color }}; --os-pad: {{ s.vertical_padding }}px;">
  <div class="waggly-os-approach__wrap">
    <div class="waggly-os-approach__intro">
      {%- if s.eyebrow != blank -%}<span class="waggly-os-approach__kicker">{{ s.eyebrow | escape }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="waggly-os-approach__heading">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.subtext != blank -%}<p class="waggly-os-approach__subtext">{{ s.subtext | escape }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="waggly-os-approach__steps">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="waggly-os-approach__step" {{ block.shopify_attributes }}>
            <div class="waggly-os-approach__ic" aria-hidden="true">
              {%- if b.svg_code != blank -%}{{ b.svg_code }}{%- endif -%}
            </div>
            {%- if b.title != blank -%}<h3>{{ b.title | escape }}</h3>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.bridge != blank -%}<p class="waggly-os-approach__bridge">{{ s.bridge }}</p>{%- endif -%}
  </div>
</section>

{% stylesheet %}
.waggly-os-approach {
  background: var(--os-bg, #0D386F);
  color: #fff;
  padding: var(--os-pad, 76px) 0;
}
.waggly-os-approach__wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
.waggly-os-approach__intro { max-width: 760px; margin: 0 auto; text-align: center; }
.waggly-os-approach__kicker {
  display: inline-block;
  font-family: var(--font-body-family);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--os-accent, #FF8FB1);
  margin-bottom: 12px;
}
.waggly-os-approach__heading {
  font-family: var(--font-heading-family);
  font-weight: 800;
  line-height: 1.15;
  color: #fff;
  font-size: clamp(28px, 3.6vw, 40px);
  margin: 0 0 18px;
}
.waggly-os-approach__subtext { color: #D6DEEC; line-height: 1.65; margin: 0; }
.waggly-os-approach__steps {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14px;
  margin-top: 36px;
  counter-reset: os-st;
}
.waggly-os-approach__step {
  background: rgba(255, 255, 255, .07);
  border: 1px solid rgba(255, 255, 255, .14);
  border-radius: 20px;
  padding: 22px 18px;
  position: relative;
}
.waggly-os-approach__step::before {
  counter-increment: os-st;
  content: "0" counter(os-st);
  display: block;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .1em;
  color: var(--os-accent, #FF8FB1);
  margin-bottom: 12px;
}
.waggly-os-approach__ic {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: rgba(255, 255, 255, .1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14px;
}
.waggly-os-approach__ic svg { width: 22px; height: 22px; }
.waggly-os-approach__step h3 {
  font-family: var(--font-heading-family);
  font-weight: 700;
  font-size: 17px;
  margin: 0;
  color: #fff;
  line-height: 1.3;
}
.waggly-os-approach__bridge {
  margin: 40px 0 0;
  text-align: center;
  font-family: var(--font-heading-family);
  font-size: clamp(20px, 2.4vw, 26px);
  font-weight: 700;
  color: #fff;
}
.waggly-os-approach__bridge em { font-style: normal; color: var(--os-accent, #FF8FB1); }

@media (max-width: 900px) {
  .waggly-os-approach__steps { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 520px) {
  .waggly-os-approach__steps { grid-template-columns: 1fr; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly OS approach",
  "tag": "section",
  "class": "waggly-os-approach-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our approach" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rooted in business consulting and financial advisory" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Our approach comes from where we have spent much of our professional lives. Our work has taught us to:" },
    { "type": "inline_richtext", "id": "bridge", "label": "Bridge line", "default": "We wanted to bring that same thinking <em>into the pet industry.</em>" },
    { "type": "header", "content": "Colours & spacing" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0D386F" },
    { "type": "color", "id": "accent_color", "label": "Accent (light pink)", "default": "#FF8FB1" },
    { "type": "range", "id": "vertical_padding", "label": "Top & bottom padding", "min": 40, "max": 120, "step": 4, "unit": "px", "default": 76 },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Gap above section",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Ask questions" },
        { "type": "html", "id": "svg_code", "label": "Icon SVG" }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "Waggly OS approach",
      "blocks": [
        { "type": "step", "settings": { "title": "Ask questions", "svg_code": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.5V14M12 17h.01\"/></svg>" } },
        { "type": "step", "settings": { "title": "Look beyond the obvious", "svg_code": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>" } },
        { "type": "step", "settings": { "title": "Research markets", "svg_code": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M21 21l-4.5-4.5\"/></svg>" } },
        { "type": "step", "settings": { "title": "Evaluate choices", "svg_code": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3v18M5 7h14M5 7l-3 7a3 3 0 0 0 6 0zM19 7l-3 7a3 3 0 0 0 6 0z\"/></svg>" } },
        { "type": "step", "settings": { "title": "Decide on what truly creates value", "svg_code": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\"/></svg>" } }
      ]
    }
  ]
}
{% endschema %}
