{%- liquid
  assign s = section.settings
  # Build the list of active columns (those with a non-blank header).
  assign active = ''
  for i in (1..8)
    assign hkey = 'header_' | append: i
    if s[hkey] != blank
      assign active = active | append: i | append: ','
    endif
  endfor
  assign active_arr = active | split: ','
  assign first_col = active_arr | first
  assign last_col = active_arr | last
-%}

<section class="waggly-table top-spacing-{{ s.top_spacing }}">
  <div class="{% if s.width == 'page-wide' %}page-wide{% else %}page-width{% endif %}">
    {%- if s.eyebrow != blank or s.heading != blank or s.subtext != blank -%}
      <header class="waggly-table__head">
        {%- if s.eyebrow != blank -%}<p class="waggly-table__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="waggly-table__heading{% if s.heading_style == 'handwritten' %} waggly-table__heading--hand{% endif %}">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.subtext != blank -%}<div class="waggly-table__subtext rte">{{ s.subtext }}</div>{%- endif -%}
      </header>
    {%- endif -%}

    {%- if active_arr.size > 0 and section.blocks.size > 0 -%}
      <div class="waggly-table__scroll{% if s.sticky_first %} waggly-table__scroll--sticky{% endif %}" tabindex="0" role="region" aria-label="{{ s.heading | default: 'Comparison table' | escape }}">
        <table class="waggly-table__table">
          <thead>
            <tr>
              {%- for i in (1..8) -%}
                {%- assign hkey = 'header_' | append: i -%}
                {%- if s[hkey] != blank -%}
                  {%- assign istr = i | append: '' -%}
                  <th scope="col" class="{% if istr == first_col %}is-row-head{% endif %}{% if s.emphasize_last and istr == last_col %} is-emph{% endif %}">{{ s[hkey] | escape }}</th>
                {%- endif -%}
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              <tr {{ block.shopify_attributes }}>
                {%- for i in (1..8) -%}
                  {%- assign hkey = 'header_' | append: i -%}
                  {%- if s[hkey] != blank -%}
                    {%- assign istr = i | append: '' -%}
                    {%- assign ckey = 'cell_' | append: i -%}
                    {%- assign cval = block.settings[ckey] -%}
                    {%- if istr == first_col -%}
                      <th scope="row" class="is-row-head">{{ cval | escape }}</th>
                    {%- else -%}
                      <td{% if s.emphasize_last and istr == last_col %} class="is-emph"{% endif %}>{{ cval | escape }}</td>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      {%- if s.scroll_hint != blank -%}
        <p class="waggly-table__hint" aria-hidden="true">{{ s.scroll_hint | escape }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.waggly-table__head { text-align: center; margin-bottom: 26px; }
.waggly-table__eyebrow {
  font-family: var(--font-body-family);
  font-weight: 600;
  font-size: .85rem;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin: 0 0 8px;
}
.waggly-table__heading {
  font-family: var(--font-heading-family);
  font-weight: 700;
  color: var(--color-base);
  font-size: clamp(1.8rem, 3.4vw, 2.8rem);
  margin: 0;
}
.waggly-table__heading--hand { font-family: 'Kalam', cursive; }
.waggly-table__subtext {
  max-width: 60ch;
  margin: 12px auto 0;
  color: var(--color-base);
  opacity: .82;
  line-height: 1.5;
}
.waggly-table__subtext p { margin: 0; }

.waggly-table__scroll {
  overflow-x: auto;
  border-radius: 24px;
  border: 1px solid var(--color-lines-borders, #F6D6DE);
  background: #fff;
  box-shadow: 0 12px 30px rgba(13, 56, 111, .06);
  -webkit-overflow-scrolling: touch;
}
.waggly-table__scroll:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

.waggly-table__table {
  width: 100%;
  min-width: 760px;
  border-collapse: collapse;
  font-size: .95rem;
}
.waggly-table__table th,
.waggly-table__table td {
  padding: 14px 16px;
  text-align: left;
  vertical-align: middle;
  white-space: nowrap;
}
.waggly-table__table thead th {
  background: var(--color-base);
  color: #fff;
  font-family: var(--font-heading-family);
  font-weight: 600;
  position: sticky;
  top: 0;
  z-index: 1;
}
.waggly-table__table tbody th,
.waggly-table__table tbody td {
  border-top: 1px solid var(--color-lines-borders, #F6D6DE);
  color: var(--color-base);
}
.waggly-table__table tbody tr:nth-child(even) th,
.waggly-table__table tbody tr:nth-child(even) td { background: #FFF4F5; }
.waggly-table__table tbody tr:nth-child(odd) th,
.waggly-table__table tbody tr:nth-child(odd) td { background: #fff; }
.waggly-table__table .is-row-head { font-weight: 700; }
.waggly-table__table tbody .is-emph { color: var(--color-accent); font-weight: 700; }
.waggly-table__table thead .is-emph { color: #fff; }

/* Sticky first column for small screens */
.waggly-table__scroll--sticky .waggly-table__table thead .is-row-head,
.waggly-table__scroll--sticky .waggly-table__table tbody .is-row-head {
  position: sticky;
  left: 0;
  z-index: 2;
}
.waggly-table__scroll--sticky .waggly-table__table thead .is-row-head { z-index: 3; }

.waggly-table__hint {
  display: none;
  text-align: center;
  font-size: .85rem;
  color: var(--color-base);
  opacity: .6;
  margin: 12px 0 0;
}

@media (max-width: 749px) {
  .waggly-table__hint { display: block; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly table",
  "tag": "section",
  "class": "waggly-table-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)", "default": "At a glance" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Side-by-side comparison" },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading style",
      "options": [
        { "value": "normal", "label": "Normal (Outfit)" },
        { "value": "handwritten", "label": "Handwritten (Kalam)" }
      ],
      "default": "normal"
    },
    { "type": "richtext", "id": "subtext", "label": "Text under heading (optional)" },
    { "type": "text", "id": "scroll_hint", "label": "Mobile scroll hint", "default": "Scroll sideways to see every column →" },
    { "type": "checkbox", "id": "sticky_first", "label": "Keep first column visible while scrolling", "default": true },
    { "type": "checkbox", "id": "emphasize_last", "label": "Highlight the last column", "default": true },
    { "type": "header", "content": "Columns", "info": "Leave a column header empty to hide that column. Cells map to these columns in order." },
    { "type": "text", "id": "header_1", "label": "Column 1 (row label)", "default": "Insurer" },
    { "type": "text", "id": "header_2", "label": "Column 2", "default": "Pets" },
    { "type": "text", "id": "header_3", "label": "Column 3", "default": "Joining age (dogs)" },
    { "type": "text", "id": "header_4", "label": "Column 4", "default": "Giant breeds up to" },
    { "type": "text", "id": "header_5", "label": "Column 5", "default": "Vet visits (OPD)" },
    { "type": "text", "id": "header_6", "label": "Column 6", "default": "Liability cover" },
    { "type": "text", "id": "header_7", "label": "Column 7", "default": "Waiting period" },
    { "type": "text", "id": "header_8", "label": "Column 8", "default": "Starts from" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Boxed" },
        { "value": "page-wide", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "normal"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "cell_1", "label": "Column 1 (row label)", "default": "Insurer name" },
        { "type": "text", "id": "cell_2", "label": "Column 2" },
        { "type": "text", "id": "cell_3", "label": "Column 3" },
        { "type": "text", "id": "cell_4", "label": "Column 4" },
        { "type": "text", "id": "cell_5", "label": "Column 5" },
        { "type": "text", "id": "cell_6", "label": "Column 6" },
        { "type": "text", "id": "cell_7", "label": "Column 7" },
        { "type": "text", "id": "cell_8", "label": "Column 8" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Waggly table",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
