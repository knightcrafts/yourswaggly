{%- liquid
  assign s = section.settings
-%}

<section class="waggly-policy top-spacing-{{ s.top_spacing }}" style="--wg-pol-card-bg: {{ s.card_bg }}; --wg-pol-badge-bg: {{ s.badge_bg }}; --wg-pol-badge-color: {{ s.badge_color }};">
  <div class="{% if s.width == 'page-wide' %}page-wide{% else %}page-width{% endif %} waggly-policy__inner">
    {%- if s.last_updated != blank -%}
      <p class="waggly-policy__updated">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9h18M8 2.5v4M16 2.5v4" stroke-linecap="round"/></svg>
        <span>Last updated: {{ s.last_updated | escape }}</span>
      </p>
    {%- endif -%}

    {%- if s.intro != blank -%}
      <div class="waggly-policy__intro rte">{{ s.intro }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="waggly-policy__list" role="list">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <li class="waggly-policy__item" {{ block.shopify_attributes }}>
            <span class="waggly-policy__num" aria-hidden="true">{{ forloop.index }}</span>
            <div class="waggly-policy__content">
              {%- if b.heading != blank -%}
                <h2 class="waggly-policy__heading">{{ b.heading | escape }}</h2>
              {%- endif -%}
              {%- if b.body != blank -%}
                <div class="waggly-policy__text rte">{{ b.body }}</div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.waggly-policy__inner { max-width: 960px; }
.waggly-policy__updated {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin: 0 0 22px;
  padding: 8px 16px;
  border-radius: 999px;
  background: var(--wg-pol-badge-bg, #E83D74);
  color: var(--wg-pol-badge-color, #fff);
  font-weight: 600;
  font-size: .9rem;
}
.waggly-policy__intro {
  color: var(--color-base);
  opacity: .85;
  line-height: 1.5;
  margin-bottom: 26px;
}
.waggly-policy__intro p { margin: 0 0 12px; }
.waggly-policy__intro p:last-child { margin-bottom: 0; }

.waggly-policy__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
  counter-reset: policy;
}
.waggly-policy__item {
  display: flex;
  align-items: flex-start;
  gap: 18px;
  background: var(--wg-pol-card-bg, #FDE4EA);
  border-radius: 20px;
  padding: 24px 26px;
}
.waggly-policy__num {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--wg-pol-badge-bg, #E83D74);
  color: var(--wg-pol-badge-color, #fff);
  font-family: var(--font-heading-family);
  font-weight: 700;
  font-size: 1.05rem;
  margin-top: 2px;
}
.waggly-policy__content { min-width: 0; }
.waggly-policy__heading {
  font-family: var(--font-heading-family);
  font-weight: 700;
  font-size: clamp(1.15rem, 2vw, 1.4rem);
  color: var(--color-base);
  margin: 0 0 8px;
}
.waggly-policy__text {
  color: var(--color-base);
  opacity: .85;
  line-height: 1.55;
}
.waggly-policy__text p { margin: 0 0 10px; }
.waggly-policy__text p:last-child { margin-bottom: 0; }
.waggly-policy__text ul,
.waggly-policy__text ol { margin: 0 0 10px; padding-inline-start: 20px; }
.waggly-policy__text li { margin: 0 0 6px; }

@media (max-width: 576px) {
  .waggly-policy__item { padding: 20px; gap: 14px; border-radius: 16px; }
  .waggly-policy__num { width: 34px; height: 34px; font-size: .95rem; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly policy",
  "tag": "section",
  "class": "waggly-policy-section",
  "settings": [
    { "type": "text", "id": "last_updated", "label": "Last updated (pill)", "info": "Leave empty to hide." },
    { "type": "richtext", "id": "intro", "label": "Intro text (optional)" },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Boxed" },
        { "value": "page-wide", "label": "Full width" }
      ],
      "default": "page-width"
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#FDE4EA" },
    { "type": "color", "id": "badge_bg", "label": "Number badge / pill background", "default": "#E83D74" },
    { "type": "color", "id": "badge_color", "label": "Number badge / pill text", "default": "#ffffff" },
    { "type": "header", "content": "Spacing" },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "normal"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Section",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Section heading" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Section content goes here.</p>" }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "Waggly policy",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
