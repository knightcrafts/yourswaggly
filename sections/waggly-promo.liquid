{%- liquid
  assign s = section.settings
-%}

<section class="waggly-promo top-spacing-{{ s.top_spacing }}">
  <div class="{% if s.width == 'page-width' %}page-width{% else %}page-wide{% endif %}">
    {%- if s.heading != blank -%}
      <h2 class="waggly-promo__heading{% if s.heading_style == 'handwritten' %} waggly-promo__heading--hand{% endif %}">{{ s.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="waggly-promo__grid" style="--promo-cols: {{ section.blocks.size | at_most: 3 }};">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <article
            class="waggly-promo__card waggly-promo__card--img-{{ b.image_position }}"
            style="--promo-bg: {{ b.bg_color }}; --promo-text: {{ b.text_color }};"
            {{ block.shopify_attributes }}
          >
            <div class="waggly-promo__body">
              {%- if b.heading != blank -%}
                <h3 class="waggly-promo__title">{{ b.heading | escape }}</h3>
              {%- endif -%}
              {%- if b.description != blank -%}
                <p class="waggly-promo__desc">{{ b.description | escape }}</p>
              {%- endif -%}
              {%- if b.cta_label != blank -%}
                <a class="waggly-promo__cta"{% if b.link != blank %} href="{{ b.link }}"{% else %} role="link" aria-disabled="true"{% endif %}>
                  {{ b.cta_label | escape }}
                  <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true" focusable="false"><path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              {%- endif -%}
            </div>
            <div class="waggly-promo__media">
              {%- if b.image != blank -%}
                {%- assign img = b.image -%}
                <img class="waggly-promo__image"
                     src="{{ img | image_url: width: 600 }}"
                     srcset="{{ img | image_url: width: 300 }} 300w, {{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 900 }} 900w"
                     sizes="(min-width: 990px) 24vw, 45vw"
                     width="{{ img.width }}" height="{{ img.height }}"
                     alt="{{ img.alt | escape }}" loading="lazy">
              {%- else -%}
                <div class="waggly-promo__image waggly-promo__image--placeholder">
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.waggly-promo__heading {
  font-family: var(--font-heading-family);
  font-weight: 700;
  font-size: clamp(1.8rem, 3.4vw, 2.8rem);
  color: var(--color-base);
  text-align: center;
  margin: 0 0 26px;
}
.waggly-promo__heading--hand { font-family: 'Kalam', cursive; }

.waggly-promo__grid {
  display: grid;
  grid-template-columns: repeat(var(--promo-cols, 2), minmax(0, 1fr));
  gap: 24px;
}
.waggly-promo__card {
  display: grid;
  grid-template-columns: 1fr minmax(0, 42%);
  align-items: center;
  gap: 16px;
  background: var(--promo-bg, #F4A9C4);
  color: var(--promo-text, #0D386F);
  border-radius: 28px;
  padding: 28px 30px;
  overflow: hidden;
}
.waggly-promo__card--img-left .waggly-promo__media { order: -1; }
.waggly-promo__body { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
.waggly-promo__title {
  font-family: 'Kalam', cursive;
  font-weight: 700;
  font-size: clamp(1.6rem, 2.6vw, 2.2rem);
  line-height: 1.1;
  color: inherit;
  margin: 0;
}
.waggly-promo__desc {
  margin: 0;
  font-size: 1rem;
  line-height: 1.4;
  color: inherit;
  opacity: .85;
}
.waggly-promo__cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 44px;
  padding: 0 22px;
  border-radius: 999px;
  background: #ffffff;
  color: var(--color-base);
  font-weight: 600;
  text-decoration: none;
  margin-top: 4px;
  transition: transform var(--duration-short, .2s) ease;
}
.waggly-promo__cta:hover { transform: translateY(-2px); }
.waggly-promo__cta[aria-disabled="true"] { opacity: .55; pointer-events: none; }

.waggly-promo__media { display: flex; align-items: center; justify-content: center; }
.waggly-promo__image { max-width: 100%; height: auto; display: block; }
.waggly-promo__image--placeholder { width: 100%; border-radius: 18px; overflow: hidden; }
.waggly-promo__image--placeholder .placeholder-svg { width: 100%; height: auto; display: block; opacity: .5; }

@media (max-width: 989px) {
  .waggly-promo__grid { grid-template-columns: 1fr; }
}
@media (max-width: 576px) {
  .waggly-promo__card { padding: 22px 20px; border-radius: 22px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Waggly promo tiles",
  "tag": "section",
  "class": "waggly-promo-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)" },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading style",
      "options": [
        { "value": "normal", "label": "Normal (Outfit)" },
        { "value": "handwritten", "label": "Handwritten (Kalam)" }
      ],
      "default": "normal"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "page-wide", "label": "Full width" },
        { "value": "page-width", "label": "Boxed" }
      ],
      "default": "page-wide"
    },
    { "type": "header", "content": "Spacing" },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "normal"
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "options": [
            { "value": "right", "label": "Right" },
            { "value": "left", "label": "Left" }
          ],
          "default": "right"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Puppy Essentials" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "A happy start for a lifetime of tail wags." },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop for Puppies" },
        { "type": "url", "id": "link", "label": "Button link" },
        { "type": "color", "id": "bg_color", "label": "Card background", "default": "#F4A9C4" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#0D386F" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Waggly promo tiles",
      "blocks": [
        { "type": "promo", "settings": { "heading": "Puppy Essentials", "description": "A happy start for a lifetime of tail wags.", "cta_label": "Shop for Puppies", "bg_color": "#F4A9C4" } },
        { "type": "promo", "settings": { "heading": "Kitten Essentials", "description": "All they need for a purr-fect start.", "cta_label": "Shop for Kittens", "bg_color": "#AEC6E4" } }
      ]
    }
  ]
}
{% endschema %}
