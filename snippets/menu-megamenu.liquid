{%- assign megamenu_block = section.blocks[megamenu_item] -%}

{%- capture megamenu_content -%}
<div class="grid">
  {%- for childlink in link.links -%}
  {%- assign c_parts = childlink.title | split: '::' -%}
  {%- assign c_label = c_parts[0] | strip -%}
  {%- assign c_icon = c_parts[2] | default: '' | strip -%}
  {%- if childlink.links != blank -%}
  <div class="{{ megamenu_block.settings.grid }}">
    <a href="{{ childlink.url }}" class="submenu__item megamenu-item h5 text-uppercase{% if childlink.current or childlink.child_active %} submenu__item--active{% endif %}">
      {%- if c_icon != blank -%}<span class="megamenu-item__icon">{%- render 'icons-list' icon_name: c_icon -%}</span>{%- endif -%}
      <span>{{ c_label | escape }}{%- render "menu-badge" item_name:c_label -%}</span>
    </a>
    <ul class="unstyle-ul megamenu-childs">
      {%- for grandchildlink in childlink.links -%}
      {%- assign g_parts = grandchildlink.title | split: '::' -%}
      {%- assign g_label = g_parts[0] | strip -%}
      {%- assign g_desc = g_parts[1] | default: '' | strip -%}
      {%- assign g_icon = g_parts[2] | default: '' | strip -%}
      <li>
        <a href="{{ grandchildlink.url }}" class="submenu__item body2 megamenu-child{% if g_desc != blank or g_icon != blank %} megamenu-child--rich{% endif %}{% if grandchildlink.current %} submenu__item--active{% endif %}">
          {%- if g_icon != blank -%}<span class="megamenu-child__icon">{%- render 'icons-list' icon_name: g_icon -%}</span>{%- endif -%}
          <span class="megamenu-child__text">
            <span class="megamenu-child__label">{{ g_label | escape }}{%- render "menu-badge" item_name:g_label -%}</span>
            {%- if g_desc != blank -%}<span class="megamenu-child__desc">{{ g_desc | escape }}</span>{%- endif -%}
          </span>
        </a>
      </li>
      {%- endfor -%}
    </ul>
  </div>
  {%- else -%}
  <div class="{{ megamenu_block.settings.grid }}">
    <a href="{{ childlink.url }}" class="submenu__item megamenu-item h5 text-uppercase{% if childlink.current or childlink.child_active %} submenu__item--active{% endif %}">
      {%- if c_icon != blank -%}<span class="megamenu-item__icon">{%- render 'icons-list' icon_name: c_icon -%}</span>{%- endif -%}
      <span>{{ c_label | escape }}{%- render "menu-badge" item_name:c_label -%}</span>
    </a>
  </div>
  {%- endif -%}
  {%- endfor -%}
</div>
{%- endcapture -%}
{%- if megamenu_block.settings.show_banner -%}
{%- capture megamenu_banner -%}
<div class="mb--last-child-0 mt--first-child-0 mt18 mb3">
  
  {%- capture image -%}
  {%- if megamenu_block.settings.image != blank -%}
  <div class="image-hover-scaling__image">
    <div class="border__radius" style="--aspect-ratio: {{megamenu_block.settings.image.aspect_ratio}};">
      {% assign imagesize = megamenu_block.settings.image.width | append: 'x' %}
      <img srcset="{{ megamenu_block.settings.image | img_url: imagesize }} 1x, {{ megamenu_block.settings.image | img_url: imagesize, scale: 2 }} 2x"
           src="{{ megamenu_block.settings.image | img_url: imagesize }}"
           loading="lazy"
           width="{{ megamenu_block.settings.image.width }}"
           height="{{ megamenu_block.settings.image.height }}"
           alt="{{ megamenu_block.settings.image.alt | escape }}"
           >
    </div>
  </div>
  {%- endif -%}
  {%- endcapture -%}
  
  {%- if megamenu_block.settings.image != blank -%}
  {%- if megamenu_block.settings.banner_link != blank -%}
  <a href="{{ megamenu_block.settings.banner_link }}" class="display-block{% if settings.enable_zoom_animation %} image-hover-scaling-up{% endif %}">
	{{ image }}
  </a>
  {%- else -%}
  <div class="mb15{% if settings.enable_zoom_animation %} image-hover-scaling-up{% endif %}">
	{{ image }}
  </div>
  {%- endif -%}
  {%- endif -%}

  {%- if megamenu_block.settings.heading != blank -%}
  <h4 class="mt15 mb0">
    {%- if megamenu_block.settings.banner_link != blank -%}
    <a href="{{ megamenu_block.settings.banner_link }}" class="animation-underline">{{ megamenu_block.settings.heading }}</a>
    {%- else -%}
    {{ megamenu_block.settings.heading }}
    {%- endif -%}
  </h4>
  {%- endif -%}

  {%- if megamenu_block.settings.text != blank -%}
  <p class="mt5">{{ megamenu_block.settings.text }}</p>
  {%- endif -%}

  {%- if megamenu_block.settings.button_label != blank -%}
  <a{% if megamenu_block.settings.banner_link != blank %} href="{{ megamenu_block.settings.banner_link }}"{% endif %} class="btn btn_zoom mt15"{% if megamenu_block.settings.banner_link == blank %} aria-disabled="true"{% endif %}><span>{{ megamenu_block.settings.button_label | escape }}</span></a>
  {%- endif -%}

</div>
<!--
<div class="rect-static-megamenu">Banner</div>
-->
{%- endcapture -%}
{%- endif -%}
{%- capture page_width -%}
{% if section.settings.width != "default" %}{{ section.settings.width }}{% else %}{{ settings.page_width_main }}{% endif %}
{%- endcapture -%}
<div class="megamenu-container" {{ megamenu_block.shopify_attributes }}>
  {%- if fullwidth_menu -%}
  <div class="submenu-design__megamenu submenu--no-radius">
    <div class="{{ page_width }}">
      {%- if megamenu_block.settings.show_banner -%}
      <div class="grid megamenu_show_banner">
        <div class="col-four_fifth">
          {{ megamenu_content }}
        </div>
        <div class="col-one_fifth">
          {{ megamenu_banner }}
        </div>
      </div>
      {%- else -%}
      {{ megamenu_content }}
      {%- endif -%}
    </div>
  </div>
  {%- else -%}
  <div class="submenu-design__megamenu {{ page_width }}">
    {%- if megamenu_block.settings.show_banner -%}
    <div class="grid megamenu_show_banner">
      <div class="col-four_fifth">
        {{ megamenu_content }}
      </div>
      <div class="col-one_fifth">
        {{ megamenu_banner }}
      </div>
    </div>
    {%- else -%}
    {{ megamenu_content }}
    {%- endif -%}
  </div>
  {%- endif -%}
</div>

{% stylesheet %}
.megamenu-item { display: inline-flex; align-items: center; gap: 8px; }
.megamenu-item__icon { display: inline-flex; align-items: center; }
.megamenu-item__icon svg, .megamenu-item__icon img { width: 20px; height: 20px; object-fit: contain; }
.megamenu-child { display: flex; align-items: flex-start; gap: 10px; }
.megamenu-child__icon { display: inline-flex; flex: 0 0 auto; margin-top: 3px; color: var(--color-accent); }
.megamenu-child__icon svg, .megamenu-child__icon img { width: 22px; height: 22px; object-fit: contain; }
.megamenu-child__text { display: flex; flex-direction: column; }
.megamenu-child--rich .megamenu-child__label { font-weight: 600; }
.megamenu-child__desc { font-size: var(--font-body3-size, 12px); line-height: 1.3; opacity: .65; margin-top: 2px; }
{% endstylesheet %}